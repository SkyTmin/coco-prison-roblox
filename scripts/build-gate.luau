-- a hanging banner (Minecraft style: a cloth 1 block wide, 2 high, on a short pole); `motif` is a second colour
-- block drawn on it (a stripe or emblem square)
local function banner(cf, color, parent, motif, w, h)
	w, h = w or B, h or 2 * B
	decor(part("BannerPole", Vector3.new(w + 0.6, 0.4, 0.4), cf * CFrame.new(0, h / 2 + 0.2, 0), Color3.fromRGB(110, 80, 50), Enum.Material.Wood, parent))
	local cloth = decor(part("Banner", Vector3.new(w, h, 0.2), cf, color, Enum.Material.Fabric, parent))
	if motif then
		decor(part("BannerMotif", Vector3.new(w * 0.5, h * 0.3, 0.24), cf * CFrame.new(0, h * 0.12, 0), motif, Enum.Material.Fabric, parent))
	end
	return cloth
end
-- flag bunting along a sagging rope from a to b (world points): small triangles in turn of the colours
local function bunting(a, b, colors, parent)
	local n = math.max(2, math.floor((b - a).Magnitude / 3))
	local prev = a
	for i = 1, n do
		local t = i / n
		local p = a:Lerp(b, t) - Vector3.new(0, math.sin(t * math.pi) * 2.2, 0)
		decor(beam("BuntingRope", prev, p, 0.15, Color3.fromRGB(70, 60, 50), parent, Enum.Material.Fabric))
		if i < n then
			local flag = decor(wedge("Flag", Vector3.new(0.15, 1.6, 1.4), CFrame.lookAt(p, p + (b - a).Unit) * CFrame.new(0, -0.8, 0) * CFrame.Angles(0, math.pi / 2, math.pi), colors[(i - 1) % #colors + 1], Enum.Material.Fabric, parent))
			flag.CastShadow = false
		end
		prev = p
	end
end
-- a fence line of posts and two rails between local points (x, z) at height y0
local function fence(ax, az, bx, bz, parent, y0, variant)
	y0 = y0 or 0
	variant = variant or WOOD_DARK
	local a, b = V(ax, y0, az), V(bx, y0, bz)
	local len = (b - a).Magnitude
	local n = math.max(1, math.floor(len / B + 0.5))
	for i = 0, n do
		local p = a:Lerp(b, i / n)
		textured(part("FencePost", Vector3.new(1, 3.4, 1), CFrame.new(p + Vector3.new(0, 1.7, 0)), nil, nil, parent), variant)
	end
	for _, h in ipairs({ 1.2, 2.6 }) do
		local rail = part("FenceRail", Vector3.new(0.4, 0.6, len), CFrame.lookAt((a + b) / 2 + Vector3.new(0, h, 0), b + Vector3.new(0, h, 0)), nil, nil, parent)
		textured(rail, variant)
	end
end
-- a striped awning (red/white like the concept): `cf` is the front-centre of the roof edge, the roof slopes up
-- toward +Z of cf over `depth`; stripes 1 block wide run front to back
local function awning(cf, width, depth, colA, colB, parent)
	local n = math.max(1, math.floor(width / B + 0.5))
	local w = width / n
	local slope = math.atan2(1.6, depth)
	for i = 0, n - 1 do
		local x = -width / 2 + (i + 0.5) * w
		local s = part("Awning", Vector3.new(w, 0.5, depth), cf * CFrame.new(x, 0.8, depth / 2) * CFrame.Angles(slope, 0, 0), if i % 2 == 0 then colA else colB, nil, parent)
		textured(s, "px_white_wool", if i % 2 == 0 then colA else colB)
		-- the scalloped valance hanging over the front
		local v = part("Valance", Vector3.new(w, 1, 0.3), cf * CFrame.new(x, -0.1, -0.1), nil, nil, parent)
		textured(decor(v), "px_white_wool", if i % 2 == 0 then colA else colB)
	end
end
-- a market stall: counter at the front (−Z of cf), four posts, a striped awning, goods on the counter and a back
-- shelf; returns the stall folder. opt: { goods = {variant, ...}, w, d, colA, colB, sign = "text" }
local function stall(cf, opt, parent)
	opt = opt or {}
	local w, d = opt.w or 3 * B, opt.d or 2 * B
	local f = folder("Stall", parent)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			textured(part("StallPost", Vector3.new(1, 8.5, 1), cf * CFrame.new(sx * (w / 2 - 0.5), 4.25, sz * (d / 2 - 0.5)), nil, nil, f), WOOD_DARK)
		end
	end
	textured(part("Counter", Vector3.new(w - 1, 3.4, 2), cf * CFrame.new(0, 1.7, -d / 2 + 1.5), nil, nil, f), WOOD)
	textured(part("CounterTop", Vector3.new(w - 0.6, 0.5, 2.6), cf * CFrame.new(0, 3.65, -d / 2 + 1.5), nil, nil, f), WOOD_DARK)
	textured(part("BackShelf", Vector3.new(w - 1, 0.5, 1.6), cf * CFrame.new(0, 5, d / 2 - 1.2), nil, nil, f), WOOD)
	textured(part("BackWall", Vector3.new(w - 1, 5.5, 0.5), cf * CFrame.new(0, 2.75, d / 2 - 0.5), nil, nil, f), WOOD_LIGHT, Color3.fromRGB(205, 170, 120))
	awning(cf * CFrame.new(0, 7.6, -d / 2 - 0.4), w + 1, d + 1, opt.colA or Color3.fromRGB(200, 45, 40), opt.colB or Color3.fromRGB(240, 235, 225), f)
	local goods = opt.goods or {}
	for i, g in ipairs(goods) do
		local gx = -w / 2 + 1.5 + (i - 1) * 2.2
		if gx < w / 2 - 1 then
			textured(decor(part("Goods", Vector3.new(1.8, 1.8, 1.8), cf * CFrame.new(gx, 4.8, -d / 2 + 1.5), nil, nil, f)), g)
			textured(decor(part("ShelfGoods", Vector3.new(1.6, 1.6, 1.2), cf * CFrame.new(gx + 0.6, 6, d / 2 - 1.2), nil, nil, f)), g)
		end
	end
	if opt.sign then
		local board = textured(part("StallSign", Vector3.new(math.min(w - 2, 8), 1.6, 0.3), cf * CFrame.new(0, 9.4, -d / 2 - 0.2), nil, nil, f), WOOD)
		boardText(board, opt.sign)
	end
	return f
end
-- a tree of blocks: trunk + layered leaf cubes (Minecraft oak-like); leafVariant e.g. "px_hedge"
local function tree(x, z, h, parent, leafVariant, trunkVariant, y0)
	y0 = y0 or 0
	local f = folder("Tree", parent)
	textured(part("Trunk", Vector3.new(B, h, B), at(x, y0 + h / 2, z), nil, nil, f), trunkVariant or "px_oak_log")
	local leaf = leafVariant or "px_hedge"
	for _, l in ipairs({ { h - 4, 5 }, { h, 5 }, { h + 4, 3 } }) do
		local r = l[2]
		textured(part("Leaves", Vector3.new(r * B, B, r * B), at(x, y0 + l[1], z), nil, nil, f), leaf)
	end
	-- a few loose leaf blocks so the crown is not a perfect stack
	for _ = 1, 4 do
		textured(part("Leaves", Vector3.new(B, B, B), at(x + rng:NextInteger(-3, 3) * B, y0 + h - 4 + rng:NextInteger(0, 2) * B, z + rng:NextInteger(-3, 3) * B), nil, nil, f), leaf)
	end
	return f
end
-- walkable stairs: visible steps on an invisible ramp; from (x, y0, z0) climbing toward z1 by `rise` (local), width w
local function stairs(name, x, z0, z1, y0, rise, w, variant, parent, axis)
	local run = math.abs(z1 - z0)
	local dir = if z1 > z0 then 1 else -1
	local steps = math.max(1, math.floor(run / 2))
	local stepD = run / steps
	for k = 0, steps - 1 do
		local top = y0 + (k + 1) * rise / steps
		local zc = z0 + dir * (k + 0.5) * stepD
		if axis == "x" then
			box(name .. "Step", zc - stepD / 2, top - B, x - w / 2, zc + stepD / 2, top, x + w / 2, variant, nil, parent)
		else
			box(name .. "Step", x - w / 2, top - B, zc - stepD / 2, x + w / 2, top, zc + stepD / 2, variant, nil, parent)
		end
	end
	-- a WedgePart is high at its +Z end: turn it so the high end points where the stairs climb to
	local highPositive = (dir > 0) == (rise > 0)
	local ramp = Instance.new("WedgePart")
	ramp.Name = name .. "Ramp"
	ramp.Anchored = true
	ramp.Transparency = 1
	ramp.Size = Vector3.new(w, math.abs(rise), run)
	if axis == "x" then
		ramp.CFrame = at((z0 + z1) / 2, y0 + rise / 2, x) * CFrame.Angles(0, if highPositive then math.pi / 2 else -math.pi / 2, 0)
	else
		ramp.CFrame = at(x, y0 + rise / 2, (z0 + z1) / 2) * CFrame.Angles(0, if highPositive then 0 else math.pi, 0)
	end
	ramp.Parent = parent or root
	return ramp
end

-- ================================================================ gameplay pieces (same contract as every location)
-- the mine pit: walls, rim, four ladder shafts and the MineAnchor (MineService fills it); size/depth in blocks
local function minePit(opt, parent)
	local mine = folder("Mine", parent)
	local size, depth = opt.size or 32, opt.depth or 12
	local w, h = size * B, depth * B
	local mx, mz = opt.x, opt.z
	local wallV, rimV = opt.wall or "px_stone_bricks", opt.rim or "px_cobblestone"
	box("PitFloor", mx - w / 2 - 2 * B, -h - B, mz - w / 2 - 2 * B, mx + w / 2 + 2 * B, -h, mz + w / 2 + 2 * B, wallV, opt.wallTint, mine)
	box("PitWall", mx - w / 2 - 2 * B, -h, mz - w / 2 - 2 * B, mx + w / 2 + 2 * B, 0, mz - w / 2, wallV, opt.wallTint, mine)
	box("PitWall", mx - w / 2 - 2 * B, -h, mz + w / 2, mx + w / 2 + 2 * B, 0, mz + w / 2 + 2 * B, wallV, opt.wallTint, mine)
	box("PitWall", mx - w / 2 - 2 * B, -h, mz - w / 2, mx - w / 2, 0, mz + w / 2, wallV, opt.wallTint, mine)
	box("PitWall", mx + w / 2, -h, mz - w / 2, mx + w / 2 + 2 * B, 0, mz + w / 2, wallV, opt.wallTint, mine)
	-- the rim one block above the market floor would trip players: it sits flush, a darker border
	for _, r in ipairs({
		{ mx - w / 2 - 2 * B, mz - w / 2 - 2 * B, mx + w / 2 + 2 * B, mz - w / 2 },
		{ mx - w / 2 - 2 * B, mz + w / 2, mx + w / 2 + 2 * B, mz + w / 2 + 2 * B },
		{ mx - w / 2 - 2 * B, mz - w / 2, mx - w / 2, mz + w / 2 },
		{ mx + w / 2, mz - w / 2, mx + w / 2 + 2 * B, mz + w / 2 },
	}) do
		box("PitRim", r[1], -0.2, r[2], r[3], 0.4, r[4], rimV, opt.rimTint, mine)
	end
	local anchor = part("MineAnchor_" .. LOC, Vector3.new(w, 0.2, w), at(mx, -0.1, mz), nil, nil, mine)
	anchor.Transparency = 1
	anchor:SetAttribute("LocationId", LOC)
	anchor:SetAttribute("MineId", LOC)
	anchor:SetAttribute("Size", Vector3.new(size, depth, size))
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.CanCollide = false
	CollectionService:AddTag(anchor, "MineAnchor")
	sign(anchor, "Шахта", 14)
	-- four 4-block ladder shafts, one per wall (MineService keeps them free)
	local LADDER_W = 4 * B
	for _, side in ipairs({
		{ mx, mz - w / 2, Vector3.new(0, 0, 1) },
		{ mx, mz + w / 2, Vector3.new(0, 0, -1) },
		{ mx - w / 2, mz, Vector3.new(1, 0, 0) },
		{ mx + w / 2, mz, Vector3.new(-1, 0, 0) },
	}) do
		local inward = side[3]
		local along = Vector3.new(math.abs(inward.Z), 0, math.abs(inward.X))
		local base = V(side[1], -h / 2, side[2])
		for k = 0, LADDER_W / 2 - 1 do
			local truss = Instance.new("TrussPart")
			truss.Name = "Ladder"
			truss.Size = Vector3.new(2, h, 2)
			truss.CFrame = CFrame.new(base - inward * 0.6 + along * (-LADDER_W / 2 + 1 + k * 2))
			truss.Anchored = true
			truss.Transparency = 1
			truss.Parent = mine
		end
		local plate = Instance.new("Part")
		plate.Name = "LadderFace"
		plate.Size = Vector3.new(LADDER_W * along.X + 0.2 * math.abs(inward.X), h, LADDER_W * along.Z + 0.2 * math.abs(inward.Z))
		plate.CFrame = CFrame.new(base + inward * 0.15)
		plate.Anchored = true
		plate.CanCollide = false
		plate.CanQuery = false
		plate.Transparency = 1
		plate.Parent = mine
		if TEX.ladder then
			local tex = Instance.new("Texture")
			tex.Texture = TEX.ladder
			tex.Face = if inward.Z > 0 then Enum.NormalId.Back elseif inward.Z < 0 then Enum.NormalId.Front elseif inward.X > 0 then Enum.NormalId.Right else Enum.NormalId.Left
			tex.StudsPerTileU, tex.StudsPerTileV = B, B
			tex.Parent = plate
		end
	end
	return mine
end
-- the arrival point (LocationSpawn) at (x, z) looking toward (lx, lz)
local function arrival(x, z, lx, lz, parent, variant)
	local spawn = part("LocationSpawn_" .. LOC, Vector3.new(4, 1, 4), CFrame.lookAt(V(x, 0.5, z), V(lx, 0.5, lz)), nil, nil, parent)
	textured(spawn, variant or WOOD)
	spawn:SetAttribute("LocationId", LOC)
	CollectionService:AddTag(spawn, "LocationSpawn")
	return spawn
end
-- an anchored R15 NPC; tag e.g. "SellPoint" (the block buyer); returns the model
local function npc(name, cf, opt, parent)
	opt = opt or {}
	local desc = Instance.new("HumanoidDescription")
	local skin = opt.skin or Color3.fromRGB(220, 180, 150)
	desc.HeadColor, desc.LeftArmColor, desc.RightArmColor = skin, skin, skin
	desc.TorsoColor = opt.shirt or Color3.fromRGB(120, 90, 60)
	desc.LeftLegColor = opt.pants or Color3.fromRGB(70, 60, 50)
	desc.RightLegColor = opt.pants or Color3.fromRGB(70, 60, 50)
	local model = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	model.Name = name
	local animate = model:FindFirstChild("Animate")
	if animate then
		animate:Destroy()
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored = true
		end
	end
	model.Parent = parent or root
	model:PivotTo(cf)
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if opt.tag then
		CollectionService:AddTag(hrp, opt.tag)
	end
	if opt.label then
		sign(hrp, opt.label, 4.5, opt.labelColor, 60)
	end
	return model
end
-- the block buyer (SellPoint), red name like every buyer [владелец 21.10]
local function buyer(cf, opt, parent)
	opt = opt or {}
	opt.tag = "SellPoint"
	opt.label = "Скупщик блоков"
	opt.labelColor = Color3.fromRGB(255, 55, 55)
	return npc("Buyer", cf, opt, parent)
end
-- the boss spawn (BossService); y local, radius = arena radius for the leash
local function bossSpawn(bossId, x, y, z, radius, parent)
	local p = part("BossSpawn", Vector3.new(4, 1, 4), at(x, y, z), nil, nil, parent)
	p.Transparency = 1
	p.CanCollide = false
	p.CanQuery = false
	p:SetAttribute("BossId", bossId)
	p:SetAttribute("ArenaRadius", radius)
	CollectionService:AddTag(p, "BossSpawn")
	return p
end
-- a stun pillar for the boss charge (BossService: parts tagged Pillar stop the charge and stun)
local function pillarTag(p)
	CollectionService:AddTag(p, "Pillar")
	return p
end
-- invisible edge walls (no falling off the floating island): list of {x, z, sx, sz} local
local function edgeWalls(list, parent)
	for _, w in ipairs(list) do
		local p = part("EdgeWall", Vector3.new(w[3], 400, w[4]), at(w[1], 150, w[2]), nil, nil, parent)
		p.Transparency = 1
		p.CanQuery = false
		p.CanTouch = false
	end
end
-- a lighting volume read by src/client/IndoorLighting.luau (Ambient, Exposure, Haze, ClockTime, Brightness,
-- AtmosphereColor, AtmosphereDecay)
local function lightingVolume(name, cx, cy, cz, sx, sy, sz, attrs, parent)
	local model = Instance.new("Model")
	model.Name = "IndoorLighting"
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	model.Parent = parent or root
	local v = decor(part(name, Vector3.new(sx, sy, sz), at(cx, cy, cz), nil, nil, model))
	v.Transparency = 1
	for k, val in pairs(attrs) do
		v:SetAttribute(k, val)
	end
	CollectionService:AddTag(v, "IndoorLighting")
	return v
end

-- ================================================================ the floating island (8-stud cells)
-- opt.shape(x, z) -> true on land; opt.top(x, z) -> variant, tint, y (the top surface height, local); opt.depth(x, z)
-- -> studs of rock below the ground block. The column is: ground (1 block, the top variant), rock (24 studs,
-- opt.rockTop) and below that opt.rockLow down to the depth. opt.voids = { {x0, x1, z0, z1, y0, y1} or
-- {cx, cz, r, y0, y1, circle = true} }: carved out of the column (crypts, tunnels, holes) — the parts that live
-- there are built by the location itself. opt.pit = PIT ({x, z, size, depth}): the mine hole is carved out too (half a
-- cell wider, under the pit walls) so the mine blocks are not buried in rock. Equal neighbouring cells along x are
-- merged into one run.
local function island(opt, parent)
	local f = folder("Island", parent)
	local C = opt.cell or 8
	local x0, x1, z0, z1 = opt.x0, opt.x1, opt.z0, opt.z1
	local voids = table.clone(opt.voids or {})
	if opt.pit then
		local p = opt.pit
		local e = p.size * B / 2 + C / 2
		table.insert(voids, { p.x - e, p.x + e, p.z - e, p.z + e, -p.depth * B, 2 * B })
	end
	local runs = 0
	-- the column segments of one cell: { {ya, yb, layer}, ... } with layer 1 ground, 2 rock, 3 low rock
	local function column(cx, cz)
		local var, tint, y = opt.top(cx, cz)
		local d = math.floor(opt.depth(cx, cz) / B + 0.5) * B
		local segs = { { y - B, y, 1 } }
		if d > 0 then
			table.insert(segs, { y - B - math.min(d, 24), y - B, 2 })
			if d > 24 then
				table.insert(segs, { y - B - d, y - B - 24, 3 })
			end
		end
		for _, v in ipairs(voids) do
			local inside, vy0, vy1
			if v.circle then
				inside = (cx - v[1]) ^ 2 + (cz - v[2]) ^ 2 <= v[3] * v[3]
				vy0, vy1 = v[4], v[5]
			else
				inside = cx >= v[1] and cx <= v[2] and cz >= v[3] and cz <= v[4]
				vy0, vy1 = v[5], v[6]
			end
			if inside then
				local cut = {}
				for _, s in ipairs(segs) do
					if s[2] <= vy0 or s[1] >= vy1 then
						table.insert(cut, s)
					else
						if s[1] < vy0 then
							table.insert(cut, { s[1], vy0, s[3] })
						end
						if s[2] > vy1 then
							table.insert(cut, { vy1, s[2], s[3] })
						end
					end
				end
				segs = cut
			end
		end
		local key = tostring(var) .. "|" .. tostring(tint)
		for _, s in ipairs(segs) do
			key ..= "|" .. s[1] .. ":" .. s[2] .. ":" .. s[3]
		end
		return key, segs, var, tint
	end
	for z = z0, z1 - C, C do
		local runStart, runKey, runSegs, runVar, runTint = nil, nil, nil, nil, nil
		local function flush(xEnd)
			if runStart then
				for _, s in ipairs(runSegs) do
					local name, variant, tint = "Ground", runVar, runTint
					if s[3] == 2 then
						name, variant, tint = "Rock", opt.rockTop or "px_stone", opt.rockTopTint
					elseif s[3] == 3 then
						name, variant, tint = "RockLow", opt.rockLow or "px_cobblestone", opt.rockLowTint
					end
					if s[2] - s[1] > 0.05 then
						box(name, runStart, s[1], z, xEnd, s[2], z + C, variant, tint, f)
					end
				end
				runs += 1
				if runs % 300 == 0 then
					task.wait()
				end
			end
			runStart = nil
		end
		for x = x0, x1 - C, C do
			local cx, cz = x + C / 2, z + C / 2
			if opt.shape(cx, cz) then
				local key, segs, var, tint = column(cx, cz)
				if key ~= runKey then
					flush(x)
					runStart, runKey, runSegs, runVar, runTint = x, key, segs, var, tint
				end
			else
				flush(x)
				runKey = nil
			end
		end
		flush(x1)
	end
	return f, runs
end

