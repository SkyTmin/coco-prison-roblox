-- a stun pillar for the boss charge (BossService: parts tagged Pillar stop the charge and stun)
local function pillarTag(p)
	CollectionService:AddTag(p, "Pillar")
	return p
end
-- invisible edge walls (no falling off the floating island): list of {x, z, sx, sz} local
local function edgeWalls(list, parent)
	for _, w in ipairs(list) do
		local p = part("EdgeWall", Vector3.new(w[3], 400, w[4]), at(w[1], 150, w[2]), nil, nil, parent)
		p.Transparency = 1
		p.CanQuery = false
		p.CanTouch = false
	end
end
-- a lighting volume read by src/client/IndoorLighting.luau (Ambient, Exposure, Haze, ClockTime, Brightness,
-- AtmosphereColor, AtmosphereDecay)
local function lightingVolume(name, cx, cy, cz, sx, sy, sz, attrs, parent)
	local model = Instance.new("Model")
	model.Name = "IndoorLighting"
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	model.Parent = parent or root
	local v = decor(part(name, Vector3.new(sx, sy, sz), at(cx, cy, cz), nil, nil, model))
	v.Transparency = 1
	for k, val in pairs(attrs) do
		v:SetAttribute(k, val)
	end
	CollectionService:AddTag(v, "IndoorLighting")
	return v
end

-- ================================================================ the floating island (8-stud cells)
-- opt.shape(x, z) -> true on land; opt.top(x, z) -> variant, tint, y (the top surface height, local); opt.depth(x, z)
-- -> studs of rock below the ground block. The column is: ground (1 block, the top variant), rock (24 studs,
-- opt.rockTop) and below that opt.rockLow down to the depth. opt.voids = { {x0, x1, z0, z1, y0, y1} or
-- {cx, cz, r, y0, y1, circle = true} }: carved out of the column (crypts, tunnels, holes) — the parts that live
-- there are built by the location itself. Equal neighbouring cells along x are merged into one run.
local function island(opt, parent)
	local f = folder("Island", parent)
	local C = opt.cell or 8
	local x0, x1, z0, z1 = opt.x0, opt.x1, opt.z0, opt.z1
	local voids = opt.voids or {}
	local runs = 0
	-- the column segments of one cell: { {ya, yb, layer}, ... } with layer 1 ground, 2 rock, 3 low rock
	local function column(cx, cz)
		local var, tint, y = opt.top(cx, cz)
		local d = math.floor(opt.depth(cx, cz) / B + 0.5) * B
		local segs = { { y - B, y, 1 } }
		if d > 0 then
			table.insert(segs, { y - B - math.min(d, 24), y - B, 2 })
			if d > 24 then
				table.insert(segs, { y - B - d, y - B - 24, 3 })
			end
		end
		for _, v in ipairs(voids) do
			local inside, vy0, vy1
			if v.circle then
				inside = (cx - v[1]) ^ 2 + (cz - v[2]) ^ 2 <= v[3] * v[3]
				vy0, vy1 = v[4], v[5]
			else
				inside = cx >= v[1] and cx <= v[2] and cz >= v[3] and cz <= v[4]
				vy0, vy1 = v[5], v[6]
			end
			if inside then
				local cut = {}
				for _, s in ipairs(segs) do
					if s[2] <= vy0 or s[1] >= vy1 then
						table.insert(cut, s)
					else
						if s[1] < vy0 then
							table.insert(cut, { s[1], vy0, s[3] })
						end
						if s[2] > vy1 then
							table.insert(cut, { vy1, s[2], s[3] })
						end
					end
				end
				segs = cut
			end
		end
		local key = tostring(var) .. "|" .. tostring(tint)
		for _, s in ipairs(segs) do
			key ..= "|" .. s[1] .. ":" .. s[2] .. ":" .. s[3]
		end
		return key, segs, var, tint
	end
	for z = z0, z1 - C, C do
		local runStart, runKey, runSegs, runVar, runTint = nil, nil, nil, nil, nil
		local function flush(xEnd)
			if runStart then
				for _, s in ipairs(runSegs) do
					local name, variant, tint = "Ground", runVar, runTint
					if s[3] == 2 then
						name, variant, tint = "Rock", opt.rockTop or "px_stone", opt.rockTopTint
					elseif s[3] == 3 then
						name, variant, tint = "RockLow", opt.rockLow or "px_cobblestone", opt.rockLowTint
					end
					if s[2] - s[1] > 0.05 then
						box(name, runStart, s[1], z, xEnd, s[2], z + C, variant, tint, f)
					end
				end
				runs += 1
				if runs % 300 == 0 then
					task.wait()
				end
			end
			runStart = nil
		end
		for x = x0, x1 - C, C do
			local cx, cz = x + C / 2, z + C / 2
			if opt.shape(cx, cz) then
				local key, segs, var, tint = column(cx, cz)
				if key ~= runKey then
					flush(x)
					runStart, runKey, runSegs, runVar, runTint = x, key, segs, var, tint
				end
			else
				flush(x)
				runKey = nil
			end
		end
		flush(x1)
	end
	return f, runs
end

-- ================================================================ the location parts follow (scripts/locations/<id>/*.luau)

-- ================================================================================ kyoto/05-plan.luau
-- ================================================================ kyoto: the plan shared by every part
local ISLAND_R = 232
local L1_Y, L2_Y = 16, 32
local PIT = { x = -24, z = 88, size = 32, depth = 12 }
local PIT_HALF = PIT.size * B / 2 -- 64
local SPAWN = { x = -24, z = 182 }
local BUYER = { x = 8, z = 186 }
local SQUARE = { -120, -8, 72, 216 } -- x0, z0, x1, z1
local MAIN_STAIR = { x0 = 24, x1 = 44, zA0 = 12, zA1 = -8, zB0 = -40, zB1 = -72 }
local WEST_STAIR = { x0 = -180, x1 = -164, z0 = 24, z1 = -8 }
local ARENA_STAIR = { x0 = -96, x1 = -80, z0 = -40, z1 = -72 }
local TEMPLE = { x0 = 64, x1 = 176, z0 = -124, z1 = -76 }
local STAGE = { x0 = 72, x1 = 176, z0 = -72, z1 = -16, y = L2_Y }
local POND = { x = 124, z = 24, r = 36, bed = -8 }
local PAGODA = { x = 110, z = -160 }
local ARENA = { x = -88, z = -128, r = 56 }

local function inRect(x, z, r, pad)
	pad = pad or 0
	return x >= r[1] - pad and x <= r[3] + pad and z >= r[2] - pad and z <= r[4] + pad
end
local function inPitArea(x, z, pad)
	local e = PIT_HALF + 2 * B + (pad or 0)
	return math.abs(x - PIT.x) <= e and math.abs(z - PIT.z) <= e
end
local function inPond(x, z, pad)
	return (x - POND.x) ^ 2 + (z - POND.z) ^ 2 <= (POND.r + (pad or 0)) ^ 2
end
local function inArena(x, z, pad)
	return (x - ARENA.x) ^ 2 + (z - ARENA.z) ^ 2 <= (ARENA.r + (pad or 0)) ^ 2
end
local function onIsland(x, z, pad)
	return math.sqrt(x * x + z * z) <= ISLAND_R - (pad or 0) + n2(x, z, 4.4, 0.03) * 10
end
-- stair corridors keep the terrace edges straight (the flights land exactly)
local function inStairCorridor(x, z)
	return (x >= MAIN_STAIR.x0 - 8 and x <= MAIN_STAIR.x1 + 8 and z >= -80 and z <= 16)
		or (x >= WEST_STAIR.x0 - 8 and x <= WEST_STAIR.x1 + 8 and z >= -16 and z <= 32)
		or (x >= ARENA_STAIR.x0 - 8 and x <= ARENA_STAIR.x1 + 8 and z >= -80 and z <= -32)
end
-- the terrace of a point: 0, 1 or 2 (the area under the stage, east of x 56, stays on L0)
local function terrace(x, z)
	local j = 0
	if not inStairCorridor(x, z) then
		j = math.floor(n2(x, z, 6.6, 0.025) * 2 + 0.5) * 8
	end
	if z < -72 + j then
		return 2
	end
	if z < -8 + j and x < 56 then
		return 1
	end
	return 0
end
local function groundY(x, z)
	local t = terrace(x, z)
	if t == 0 and inPond(x, z) then
		return POND.bed
	end
	return if t == 2 then L2_Y elseif t == 1 then L1_Y else 0
end
-- the zone that owns a point (who builds there): "temple", "hill" or "town"
local function zoneOf(x, z)
	if (x >= 56 and z <= 64) or (x >= 20 and x <= 48 and z >= -76 and z <= 14) then
		return "temple"
	end
	if x < 56 and z < -8 then
		return "hill"
	end
	return "town"
end
-- free ground for trees and props in a zone: on the island, off the square paths, the pit, the stairs and the arrival
local function freeGround(x, z, pad)
	pad = pad or 0
	return onIsland(x, z, 10 + pad)
		and not inPitArea(x, z, 6 + pad)
		and not inStairCorridor(x, z)
		and not inPond(x, z, 4 + pad)
		and not inArena(x, z, 6 + pad)
		and not (x >= STAGE.x0 - pad and x <= STAGE.x1 + pad and z >= STAGE.z0 - pad and z <= STAGE.z1 + pad)
		and math.sqrt((x - SPAWN.x) ^ 2 + (z - SPAWN.z) ^ 2) > 20 + pad
		and math.sqrt((x - BUYER.x) ^ 2 + (z - BUYER.z) ^ 2) > 14 + pad
end

-- palette: spring Kyoto
local SAKURA = Color3.fromRGB(246, 170, 205)
local SAKURA_DEEP = Color3.fromRGB(226, 120, 170)
local TORII_RED = Color3.fromRGB(200, 40, 34)
local DARK_WOOD = Color3.fromRGB(70, 50, 40)
local ROOF_DARK = Color3.fromRGB(52, 50, 56)
local STONE = Color3.fromRGB(160, 158, 154)
local GRASS = Color3.fromRGB(150, 196, 110)
local WATER_C = Color3.fromRGB(80, 160, 200)
local PAPER = Color3.fromRGB(245, 236, 214)

-- ================================================================================ kyoto/10-core.luau
do
-- ================================================================ kyoto: the island, the terraces, the pond, the mine
local core = folder("Core")

-- the ground of a cell: cobbles on the square, a stone court round the temple, planks under the arena (the hill part
-- lays the wooden floor on it), a pebble bed in the pond, spring grass with petal-pink patches everywhere else
local function groundTop(x, z)
	local y = groundY(x, z)
	local n = n2(x, z, 3.3, 0.05)
	if y == POND.bed then
		return "px_gravel", Color3.fromRGB(150, 150, 140), y
	end
	if y == 0 and inRect(x, z, SQUARE) and onIsland(x, z, 12) then
		if inPitArea(x, z) then
			return "px_stone_bricks", STONE, 0
		end
		return if n > 0.25 then "px_cobblestone" else "px_stone_bricks", STONE, 0
	end
	if y == L2_Y and inRect(x, z, { TEMPLE.x0 - 16, TEMPLE.z0 - 56, TEMPLE.x1 + 8, TEMPLE.z1 + 4 }) then
		return "px_smooth_stone", STONE, y -- the temple court and the pagoda yard
	end
	if y == L2_Y and inArena(x, z, 4) then
		return "px_stone_bricks", STONE, y
	end
	if n > 0.36 then
		return "px_forest_floor", nil, y
	end
	if n < -0.38 then
		return "px_grass_top", Color3.fromRGB(235, 170, 196), y -- fallen petals over the grass
	end
	return "px_grass_top", GRASS, y
end
-- stone cliffs: the island hangs as a terraced block of stone, deepest under its middle (16-stud steps)
local function rockDepth(x, z)
	local rr = math.clamp(math.sqrt(x * x + z * z) / ISLAND_R, 0, 1)
	local d = 16 + (1 - rr) ^ 1.2 * 140 + groundY(x, z)
	if rr > 0.85 then
		d += (n2(x, z, 7.7, 0.09) + 0.5) * 24
	end
	return math.max(12, math.floor(d / 16 + 0.5) * 16)
end
local _, islandRuns = island({
	x0 = -248,
	x1 = 248,
	z0 = -248,
	z1 = 248,
	cell = 8,
	shape = function(x, z)
		return onIsland(x, z)
	end,
	top = groundTop,
	depth = rockDepth,
	rockTop = "px_stone",
	rockTopTint = Color3.fromRGB(150, 150, 150),
	rockLow = "px_stone",
	rockLowTint = Color3.fromRGB(116, 116, 120),
}, core)
task.wait()

-- ================================================================ the pond (px_water, walk-through) and the stage's footing
do
	local water = folder("Water", core)
	-- the water fills the pond bed in 8-stud strips that follow the circle (cells of the island grid)
	for z = POND.z - POND.r, POND.z + POND.r - 8, 8 do
		local x0, x1
		for x = POND.x - POND.r, POND.x + POND.r - 8, 8 do
			if groundY(x + 4, z + 4) == POND.bed then
				x0 = x0 or x
				x1 = x + 8
			end
		end
		if x0 then
			local p = box("Pond", x0, POND.bed, z, x1, -1, z + 8, "px_water", WATER_C, water)
			p.Transparency = 0.3
			p.CanCollide = false
			p.CanQuery = false
			p.CastShadow = false
		end
	end
end

-- ================================================================ the mine in the lower square
local mine = minePit({
	x = PIT.x,
	z = PIT.z,
	size = PIT.size,
	depth = PIT.depth,
	wall = "px_stone_bricks",
	wallTint = Color3.fromRGB(130, 128, 126),
	rim = "px_smooth_stone",
	rimTint = STONE,
}, core)
do
	-- petals drifted into the corners of the pit rim
	local e = PIT_HALF + B
	for _, s in ipairs({ { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }) do
		local cx, cz = PIT.x + s[1] * e, PIT.z + s[2] * e
		decor(box("Petals", cx - 3, 0.4, cz - 3, cx + 3, 0.6, cz + 3, "px_white_wool", SAKURA, mine))
	end
end
local arrive = folder("Arrival", core)
arrival(SPAWN.x, SPAWN.z, PIT.x, PIT.z, arrive, "px_cherry_planks")
do
	local cf = at(BUYER.x, 0, BUYER.z) * CFrame.Angles(0, math.pi / 2, 0)
	stall(cf, {
		w = 4 * B,
		d = 2 * B,
		colA = TORII_RED,
		colB = PAPER,
		goods = { "px_white_wool", "px_sea_lantern", "px_white_wool" },
		sign = "Скупка",
	}, arrive)
	buyer(cf * CFrame.new(0, 3, 1.4), { shirt = Color3.fromRGB(60, 50, 90), pants = Color3.fromRGB(40, 36, 44) }, arrive)
	barrel(BUYER.x + 3, 0, BUYER.z + 10, arrive)
	crate(BUYER.x - 3, 0, BUYER.z + 10, arrive)
	zoneSign(SPAWN.x - 14, SPAWN.z + 8, "Киото", math.pi, arrive)
end

-- ================================================================ the boss, the petals in the air, the void net, the edge walls
bossSpawn("the_lovers", ARENA.x, L2_Y + 2, ARENA.z, ARENA.r - 8, core)
do
	-- cherry petals drifting over the whole island (open day light: no lighting volume on this floor)
	for _, a in ipairs({ { 0, 0, 440, 440 } }) do
		local p = decor(part("PetalFall", Vector3.new(a[3], 1, a[4]), at(a[1], 70, a[2]), nil, nil, core))
		p.Transparency = 1
		emitter(p, {
			Rate = 30,
			Lifetime = NumberRange.new(10, 16),
			Speed = NumberRange.new(2, 4),
			SpreadAngle = Vector2.new(35, 35),
			EmissionDirection = Enum.NormalId.Bottom,
			Size = NumberSequence.new(0.35),
			Color = ColorSequence.new(SAKURA),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.1, 0.1), NumberSequenceKeypoint.new(0.9, 0.1), NumberSequenceKeypoint.new(1, 1) }),
			RotSpeed = NumberRange.new(-90, 90),
			Rotation = NumberRange.new(0, 360),
		})
	end
	local net = part("VoidCatch", Vector3.new(800, 10, 800), at(0, -240, 0), nil, nil, core)
	net.Transparency = 1
	net.CanCollide = false
	net.CanTouch = false
	net.CastShadow = false
	net:SetAttribute("LocationId", LOC)
	CollectionService:AddTag(net, "VoidCatch")
	local E = ISLAND_R + 24
