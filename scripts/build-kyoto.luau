-- the mine pit: walls, rim, four ladder shafts and the MineAnchor (MineService fills it); size/depth in blocks
local function minePit(opt, parent)
	local mine = folder("Mine", parent)
	local size, depth = opt.size or 32, opt.depth or 12
	local w, h = size * B, depth * B
	local mx, mz = opt.x, opt.z
	local wallV, rimV = opt.wall or "px_stone_bricks", opt.rim or "px_cobblestone"
	box("PitFloor", mx - w / 2 - 2 * B, -h - B, mz - w / 2 - 2 * B, mx + w / 2 + 2 * B, -h, mz + w / 2 + 2 * B, wallV, opt.wallTint, mine)
	box("PitWall", mx - w / 2 - 2 * B, -h, mz - w / 2 - 2 * B, mx + w / 2 + 2 * B, 0, mz - w / 2, wallV, opt.wallTint, mine)
	box("PitWall", mx - w / 2 - 2 * B, -h, mz + w / 2, mx + w / 2 + 2 * B, 0, mz + w / 2 + 2 * B, wallV, opt.wallTint, mine)
	box("PitWall", mx - w / 2 - 2 * B, -h, mz - w / 2, mx - w / 2, 0, mz + w / 2, wallV, opt.wallTint, mine)
	box("PitWall", mx + w / 2, -h, mz - w / 2, mx + w / 2 + 2 * B, 0, mz + w / 2, wallV, opt.wallTint, mine)
	-- the rim one block above the market floor would trip players: it sits flush, a darker border
	for _, r in ipairs({
		{ mx - w / 2 - 2 * B, mz - w / 2 - 2 * B, mx + w / 2 + 2 * B, mz - w / 2 },
		{ mx - w / 2 - 2 * B, mz + w / 2, mx + w / 2 + 2 * B, mz + w / 2 + 2 * B },
		{ mx - w / 2 - 2 * B, mz - w / 2, mx - w / 2, mz + w / 2 },
		{ mx + w / 2, mz - w / 2, mx + w / 2 + 2 * B, mz + w / 2 },
	}) do
		box("PitRim", r[1], -0.2, r[2], r[3], 0.4, r[4], rimV, opt.rimTint, mine)
	end
	local anchor = part("MineAnchor_" .. LOC, Vector3.new(w, 0.2, w), at(mx, -0.1, mz), nil, nil, mine)
	anchor.Transparency = 1
	anchor:SetAttribute("LocationId", LOC)
	anchor:SetAttribute("MineId", LOC)
	anchor:SetAttribute("Size", Vector3.new(size, depth, size))
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.CanCollide = false
	CollectionService:AddTag(anchor, "MineAnchor")
	sign(anchor, "Шахта", 14)
	-- four 4-block ladder shafts, one per wall (MineService keeps them free)
	local LADDER_W = 4 * B
	for _, side in ipairs({
		{ mx, mz - w / 2, Vector3.new(0, 0, 1) },
		{ mx, mz + w / 2, Vector3.new(0, 0, -1) },
		{ mx - w / 2, mz, Vector3.new(1, 0, 0) },
		{ mx + w / 2, mz, Vector3.new(-1, 0, 0) },
	}) do
		local inward = side[3]
		local along = Vector3.new(math.abs(inward.Z), 0, math.abs(inward.X))
		local base = V(side[1], -h / 2, side[2])
		for k = 0, LADDER_W / 2 - 1 do
			local truss = Instance.new("TrussPart")
			truss.Name = "Ladder"
			truss.Size = Vector3.new(2, h, 2)
			truss.CFrame = CFrame.new(base - inward * 0.6 + along * (-LADDER_W / 2 + 1 + k * 2))
			truss.Anchored = true
			truss.Transparency = 1
			truss.Parent = mine
		end
		local plate = Instance.new("Part")
		plate.Name = "LadderFace"
		plate.Size = Vector3.new(LADDER_W * along.X + 0.2 * math.abs(inward.X), h, LADDER_W * along.Z + 0.2 * math.abs(inward.Z))
		plate.CFrame = CFrame.new(base + inward * 0.15)
		plate.Anchored = true
		plate.CanCollide = false
		plate.CanQuery = false
		plate.Transparency = 1
		plate.Parent = mine
		if TEX.ladder then
			local tex = Instance.new("Texture")
			tex.Texture = TEX.ladder
			tex.Face = if inward.Z > 0 then Enum.NormalId.Back elseif inward.Z < 0 then Enum.NormalId.Front elseif inward.X > 0 then Enum.NormalId.Right else Enum.NormalId.Left
			tex.StudsPerTileU, tex.StudsPerTileV = B, B
			tex.Parent = plate
		end
	end
	return mine
end
-- the arrival point (LocationSpawn) at (x, z) looking toward (lx, lz)
local function arrival(x, z, lx, lz, parent, variant)
	local spawn = part("LocationSpawn_" .. LOC, Vector3.new(4, 1, 4), CFrame.lookAt(V(x, 0.5, z), V(lx, 0.5, lz)), nil, nil, parent)
	textured(spawn, variant or WOOD)
	spawn:SetAttribute("LocationId", LOC)
	CollectionService:AddTag(spawn, "LocationSpawn")
	return spawn
end
-- an anchored R15 NPC; tag e.g. "SellPoint" (the block buyer); returns the model
local function npc(name, cf, opt, parent)
	opt = opt or {}
	local desc = Instance.new("HumanoidDescription")
	local skin = opt.skin or Color3.fromRGB(220, 180, 150)
	desc.HeadColor, desc.LeftArmColor, desc.RightArmColor = skin, skin, skin
	desc.TorsoColor = opt.shirt or Color3.fromRGB(120, 90, 60)
	desc.LeftLegColor = opt.pants or Color3.fromRGB(70, 60, 50)
	desc.RightLegColor = opt.pants or Color3.fromRGB(70, 60, 50)
	local model = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	model.Name = name
	local animate = model:FindFirstChild("Animate")
	if animate then
		animate:Destroy()
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored = true
		end
	end
	model.Parent = parent or root
	model:PivotTo(cf)
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if opt.tag then
		CollectionService:AddTag(hrp, opt.tag)
	end
	if opt.label then
		sign(hrp, opt.label, 4.5, opt.labelColor, 60)
	end
	return model
end
-- the block buyer (SellPoint), red name like every buyer [владелец 21.10]
local function buyer(cf, opt, parent)
	opt = opt or {}
	opt.tag = "SellPoint"
	opt.label = "Скупщик блоков"
	opt.labelColor = Color3.fromRGB(255, 55, 55)
	return npc("Buyer", cf, opt, parent)
end
-- the boss spawn (BossService); y local, radius = arena radius for the leash
local function bossSpawn(bossId, x, y, z, radius, parent)
	local p = part("BossSpawn", Vector3.new(4, 1, 4), at(x, y, z), nil, nil, parent)
	p.Transparency = 1
	p.CanCollide = false
	p.CanQuery = false
	p:SetAttribute("BossId", bossId)
	p:SetAttribute("ArenaRadius", radius)
	CollectionService:AddTag(p, "BossSpawn")
