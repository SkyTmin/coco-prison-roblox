	end
	tb("ToriiNuki", -hs - 2.5, h - 4, -0.8, hs + 2.5, h - 2.8, 0.8, RED_V, TORII_RED)
	tb("ToriiKasagi", -hs - 3.5, h, -1.4, hs + 3.5, h + 1.4, 1.4, RED_V, TORII_RED)
