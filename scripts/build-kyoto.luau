-- flag bunting along a sagging rope from a to b (world points): small triangles in turn of the colours
local function bunting(a, b, colors, parent)
	local n = math.max(2, math.floor((b - a).Magnitude / 3))
	local prev = a
	for i = 1, n do
		local t = i / n
		local p = a:Lerp(b, t) - Vector3.new(0, math.sin(t * math.pi) * 2.2, 0)
		decor(beam("BuntingRope", prev, p, 0.15, Color3.fromRGB(70, 60, 50), parent, Enum.Material.Fabric))
		if i < n then
			local flag = decor(wedge("Flag", Vector3.new(0.15, 1.6, 1.4), CFrame.lookAt(p, p + (b - a).Unit) * CFrame.new(0, -0.8, 0) * CFrame.Angles(0, math.pi / 2, math.pi), colors[(i - 1) % #colors + 1], Enum.Material.Fabric, parent))
			flag.CastShadow = false
		end
		prev = p
	end
end
-- a fence line of posts and two rails between local points (x, z) at height y0
local function fence(ax, az, bx, bz, parent, y0, variant)
	y0 = y0 or 0
	variant = variant or WOOD_DARK
	local a, b = V(ax, y0, az), V(bx, y0, bz)
	local len = (b - a).Magnitude
	local n = math.max(1, math.floor(len / B + 0.5))
	for i = 0, n do
		local p = a:Lerp(b, i / n)
		textured(part("FencePost", Vector3.new(1, 3.4, 1), CFrame.new(p + Vector3.new(0, 1.7, 0)), nil, nil, parent), variant)
	end
	for _, h in ipairs({ 1.2, 2.6 }) do
		local rail = part("FenceRail", Vector3.new(0.4, 0.6, len), CFrame.lookAt((a + b) / 2 + Vector3.new(0, h, 0), b + Vector3.new(0, h, 0)), nil, nil, parent)
		textured(rail, variant)
	end
end
-- a striped awning (red/white like the concept): `cf` is the front-centre of the roof edge, the roof slopes up
-- toward +Z of cf over `depth`; stripes 1 block wide run front to back
local function awning(cf, width, depth, colA, colB, parent)
	local n = math.max(1, math.floor(width / B + 0.5))
	local w = width / n
	local slope = math.atan2(1.6, depth)
	for i = 0, n - 1 do
		local x = -width / 2 + (i + 0.5) * w
		local s = part("Awning", Vector3.new(w, 0.5, depth), cf * CFrame.new(x, 0.8, depth / 2) * CFrame.Angles(slope, 0, 0), if i % 2 == 0 then colA else colB, nil, parent)
		textured(s, "px_white_wool", if i % 2 == 0 then colA else colB)
		-- the scalloped valance hanging over the front
		local v = part("Valance", Vector3.new(w, 1, 0.3), cf * CFrame.new(x, -0.1, -0.1), nil, nil, parent)
		textured(decor(v), "px_white_wool", if i % 2 == 0 then colA else colB)
	end
end
-- a market stall: counter at the front (−Z of cf), four posts, a striped awning, goods on the counter and a back
-- shelf; returns the stall folder. opt: { goods = {variant, ...}, w, d, colA, colB, sign = "text" }
local function stall(cf, opt, parent)
	opt = opt or {}
	local w, d = opt.w or 3 * B, opt.d or 2 * B
	local f = folder("Stall", parent)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			textured(part("StallPost", Vector3.new(1, 8.5, 1), cf * CFrame.new(sx * (w / 2 - 0.5), 4.25, sz * (d / 2 - 0.5)), nil, nil, f), WOOD_DARK)
		end
	end
	textured(part("Counter", Vector3.new(w - 1, 3.4, 2), cf * CFrame.new(0, 1.7, -d / 2 + 1.5), nil, nil, f), WOOD)
	textured(part("CounterTop", Vector3.new(w - 0.6, 0.5, 2.6), cf * CFrame.new(0, 3.65, -d / 2 + 1.5), nil, nil, f), WOOD_DARK)
	textured(part("BackShelf", Vector3.new(w - 1, 0.5, 1.6), cf * CFrame.new(0, 5, d / 2 - 1.2), nil, nil, f), WOOD)
	textured(part("BackWall", Vector3.new(w - 1, 5.5, 0.5), cf * CFrame.new(0, 2.75, d / 2 - 0.5), nil, nil, f), WOOD_LIGHT, Color3.fromRGB(205, 170, 120))
	awning(cf * CFrame.new(0, 7.6, -d / 2 - 0.4), w + 1, d + 1, opt.colA or Color3.fromRGB(200, 45, 40), opt.colB or Color3.fromRGB(240, 235, 225), f)
	local goods = opt.goods or {}
	for i, g in ipairs(goods) do
		local gx = -w / 2 + 1.5 + (i - 1) * 2.2
		if gx < w / 2 - 1 then
			textured(decor(part("Goods", Vector3.new(1.8, 1.8, 1.8), cf * CFrame.new(gx, 4.8, -d / 2 + 1.5), nil, nil, f)), g)
			textured(decor(part("ShelfGoods", Vector3.new(1.6, 1.6, 1.2), cf * CFrame.new(gx + 0.6, 6, d / 2 - 1.2), nil, nil, f)), g)
		end
	end
	if opt.sign then
		local board = textured(part("StallSign", Vector3.new(math.min(w - 2, 8), 1.6, 0.3), cf * CFrame.new(0, 9.4, -d / 2 - 0.2), nil, nil, f), WOOD)
		boardText(board, opt.sign)
	end
	return f
end
-- a tree of blocks: trunk + layered leaf cubes (Minecraft oak-like); leafVariant e.g. "px_hedge"
local function tree(x, z, h, parent, leafVariant, trunkVariant, y0)
	y0 = y0 or 0
	local f = folder("Tree", parent)
	textured(part("Trunk", Vector3.new(B, h, B), at(x, y0 + h / 2, z), nil, nil, f), trunkVariant or "px_oak_log")
	local leaf = leafVariant or "px_hedge"
	for _, l in ipairs({ { h - 4, 5 }, { h, 5 }, { h + 4, 3 } }) do
		local r = l[2]
		textured(part("Leaves", Vector3.new(r * B, B, r * B), at(x, y0 + l[1], z), nil, nil, f), leaf)
	end
	-- a few loose leaf blocks so the crown is not a perfect stack
	for _ = 1, 4 do
		textured(part("Leaves", Vector3.new(B, B, B), at(x + rng:NextInteger(-3, 3) * B, y0 + h - 4 + rng:NextInteger(0, 2) * B, z + rng:NextInteger(-3, 3) * B), nil, nil, f), leaf)
	end
	return f
end
-- walkable stairs: visible steps on an invisible ramp; from (x, y0, z0) climbing toward z1 by `rise` (local), width w
local function stairs(name, x, z0, z1, y0, rise, w, variant, parent, axis)
	local run = math.abs(z1 - z0)
	local dir = if z1 > z0 then 1 else -1
	local steps = math.max(1, math.floor(run / 2))
	local stepD = run / steps
	for k = 0, steps - 1 do
		local top = y0 + (k + 1) * rise / steps
		local zc = z0 + dir * (k + 0.5) * stepD
		if axis == "x" then
			box(name .. "Step", zc - stepD / 2, top - B, x - w / 2, zc + stepD / 2, top, x + w / 2, variant, nil, parent)
		else
			box(name .. "Step", x - w / 2, top - B, zc - stepD / 2, x + w / 2, top, zc + stepD / 2, variant, nil, parent)
		end
	end
	-- a WedgePart is high at its +Z end: turn it so the high end points where the stairs climb to
	local highPositive = (dir > 0) == (rise > 0)
	local ramp = Instance.new("WedgePart")
	ramp.Name = name .. "Ramp"
	ramp.Anchored = true
	ramp.Transparency = 1
	ramp.Size = Vector3.new(w, math.abs(rise), run)
	if axis == "x" then
		ramp.CFrame = at((z0 + z1) / 2, y0 + rise / 2, x) * CFrame.Angles(0, if highPositive then math.pi / 2 else -math.pi / 2, 0)
	else
		ramp.CFrame = at(x, y0 + rise / 2, (z0 + z1) / 2) * CFrame.Angles(0, if highPositive then 0 else math.pi, 0)
	end
	ramp.Parent = parent or root
	return ramp
end

