-- ================================================================================ inside_out/05-plan.luau
-- ================================================================ inside_out: the plan shared by every part
local MAIN = { rx = 220, rz = 200 }
local PIT = { x = 0, z = -8, size = 32, depth = 12 }
local PIT_HALF = PIT.size * B / 2 -- 64
local SPAWN = { x = 0, z = 84 }
local BUYER = { x = 32, z = 84 }
local SQUARE = { -96, -104, 96, 100 } -- x0, z0, x1, z1
local RING = { -116, -124, 116, 120 } -- the outer edge of the ring road (the square sits inside it)
local MANSION = { x = 0, z = -330, r = 68, y = 48 }
local ARENA = { x = 0, z = 320, r = 56, islandR = 76, y = -16 }
local ISLETS = { { x = -120, z = 262, r = 24, y = -8 }, { x = 120, z = 262, r = 24, y = -8 } }
-- street segments { ax, az, bx, bz, half-width } (asphalt; the ring road is RING minus SQUARE)
local STREETS = {
	{ -220, -8, -116, -8, 10 }, -- west
	{ 116, -8, 220, -8, 10 }, -- east
	{ 0, -200, 0, -124, 10 }, -- north (→ the sky road)
	{ 0, 120, 0, 200, 10 }, -- south (→ the arena bridge)
	{ -116, 120, -120, 190, 10 }, -- south-west (→ the west islet)
	{ 116, 120, 120, 190, 10 }, -- south-east (→ the east islet)
}
-- house districts (x0, z0, x1, z1): lots front the streets; keep 1 block off every street and the island edge
local DISTRICTS = {
	NW = { -200, -168, -128, -26 },
	SW = { -200, 10, -132, 150 },
	NE = { 128, -168, 200, -26 }, -- the church
	SE = { 132, 10, 200, 150 },
	NNW = { -104, -180, -16, -132 }, -- the alphabet wall
	NNE = { 16, -180, 104, -132 },
	SSW = { -104, 128, -16, 186 },
	SSE = { 16, 128, 104, 186 },
}

local function inRect(x, z, r, pad)
	pad = pad or 0
	return x >= r[1] - pad and x <= r[3] + pad and z >= r[2] - pad and z <= r[4] + pad
end
local function inPitArea(x, z, pad)
	local e = PIT_HALF + 2 * B + (pad or 0)
	return math.abs(x - PIT.x) <= e and math.abs(z - PIT.z) <= e
end
local function onStreet(x, z, pad)
	pad = pad or 0
	for _, s in ipairs(STREETS) do
		if segDist(x, z, s[1], s[2], s[3], s[4]) <= s[5] + pad then
			return true
		end
	end
	return inRect(x, z, RING, pad) and not inRect(x, z, SQUARE, -pad)
end
-- the main island's outline (a rounded square with a ragged edge); pad > 0 keeps away from the rim
local function onMain(x, z, pad)
	pad = pad or 0
	local jag = n2(x, z, 5.3, 0.035) * 0.08 + n2(x, z, 9.1, 0.12) * 0.03
	local v = (math.abs(x) / (MAIN.rx - pad)) ^ 4 + (math.abs(z) / (MAIN.rz - pad)) ^ 4
	return v <= 1 + jag
end
local function inDisc(x, z, c, r)
	return (x - c.x) ^ 2 + (z - c.z) ^ 2 <= r * r
end
-- the ground height of a cell (nil = void): the main island at 0, the mansion island, the arena island, the islets
local function groundY(x, z)
	if onMain(x, z) then
		return 0
	end
	local jag = n2(x, z, 2.2, 0.08) * 8
	if inDisc(x, z, MANSION, MANSION.r + jag) then
		return MANSION.y
	end
	if inDisc(x, z, ARENA, ARENA.islandR + jag * 0.5) then
		return ARENA.y
	end
	for _, s in ipairs(ISLETS) do
		if inDisc(x, z, s, s.r + jag * 0.5) then
			return s.y
		end
	end
	return nil
end
-- free town ground for props: on the main island, off the streets, the square, the pit and the path ends
local function freeTown(x, z, pad)
	pad = pad or 0
	return onMain(x, z, 8 + pad)
		and not onStreet(x, z, 4 + pad)
		and not inRect(x, z, SQUARE, pad)
		and math.sqrt((x - SPAWN.x) ^ 2 + (z - SPAWN.z) ^ 2) > 20 + pad
end

-- palette: the dead suburb under a red sky
local ASPHALT = Color3.fromRGB(62, 60, 64)
local LINE_YELLOW = Color3.fromRGB(232, 190, 40)
local COBBLE = Color3.fromRGB(150, 146, 146)
local DEAD_GRASS = Color3.fromRGB(128, 104, 88)
local VINE_RED = Color3.fromRGB(150, 24, 30)
local VINE_DARK = Color3.fromRGB(96, 14, 22)
local ROCK_RED = Color3.fromRGB(120, 92, 92)
local ASH = Color3.fromRGB(214, 206, 204)
local GLOW_RED = Color3.fromRGB(255, 60, 40)

-- ================================================================================ inside_out/10-core.luau
do
-- ================================================================ inside_out: the islands, the ground, the mine, arrival
local core = folder("Core")

-- the ground of a cell: grey cobbles on the square, asphalt streets (the town part paints the yellow lines), dead
-- lawns eaten by crimson vine carpets; the mansion island overgrown, the arena island dark stone (the arena part lays
-- its cracked pattern on it), the islets half vine, half stone
local function groundTop(x, z)
	local y = groundY(x, z)
	local n = n2(x, z, 3.7, 0.05)
	local m = n2(x, z, 8.1, 0.018)
	if y == 0 then
		if inPitArea(x, z) then
			return "px_stone_bricks", COBBLE, 0
		end
		if inRect(x, z, SQUARE) then
			return if n > 0.3 then "px_cobblestone" else "px_stone_bricks", COBBLE, 0
		end
		if onStreet(x, z) then
			return "px_smooth_stone", ASPHALT, 0
		end
		if m > 0.18 or n > 0.38 then
			return "px_crimson_nylium", nil, 0 -- the vine carpet creeps over the lawns
		end
		if n < -0.32 then
			return "px_dirt", Color3.fromRGB(120, 96, 88), 0
		end
		return "px_grass_top", DEAD_GRASS, 0
	end
	if y == MANSION.y then
		if math.abs(x - MANSION.x) <= 8 and z > MANSION.z + 20 then
			return "px_stone_bricks", COBBLE, y -- the drive up to the porch
		end
		return if n > 0.05 then "px_crimson_nylium" else "px_grass_top", if n > 0.05 then nil else DEAD_GRASS, y
	end
	if y == ARENA.y then
		return "px_blackstone", Color3.fromRGB(150, 140, 146), y
	end
	return if n > 0 then "px_crimson_nylium" else "px_cobblestone", if n > 0 then nil else COBBLE, y
end
-- every island hangs as an upside-down cone of dirt and dark rock: deepest under its middle, ragged below
local function rockDepth(x, z)
	local y = groundY(x, z)
	local jag = (n2(x, z, 7.7, 0.09) + 0.5) * 22 + n2(x, z, 3.1, 0.035) * 14
	local rr, deep
	if y == 0 then
		rr = ((math.abs(x) / MAIN.rx) ^ 4 + (math.abs(z) / MAIN.rz) ^ 4) ^ 0.25
		deep = 150
	elseif y == MANSION.y then
		rr, deep = math.sqrt((x - MANSION.x) ^ 2 + (z - MANSION.z) ^ 2) / MANSION.r, 96
	elseif y == ARENA.y then
		rr, deep = math.sqrt((x - ARENA.x) ^ 2 + (z - ARENA.z) ^ 2) / ARENA.islandR, 80
	else
		local s = if x < 0 then ISLETS[1] else ISLETS[2]
		rr, deep = math.sqrt((x - s.x) ^ 2 + (z - s.z) ^ 2) / s.r, 36
	end
	rr = math.clamp(rr, 0, 1)
	-- terraced in 16-stud steps (blocky, and equal neighbours merge into one run); ragged only near the rim
	local d = 10 + (1 - rr) ^ 1.4 * deep
	if rr > 0.82 then
		d += jag
	end
	return math.max(8, math.floor(d / 16 + 0.5) * 16)
end
local _, islandRuns = island({
	pit = PIT, -- the mine hole stays open
	x0 = -240,
	x1 = 240,
	z0 = -408,
	z1 = 408,
	cell = 8,
	shape = function(x, z)
		return groundY(x, z) ~= nil
	end,
	top = groundTop,
	depth = rockDepth,
	rockTop = "px_dirt",
	rockTopTint = Color3.fromRGB(150, 108, 100),
	rockLow = "px_blackstone",
	rockLowTint = ROCK_RED,
}, core)
task.wait()

-- ================================================================ the mine in the town square
local mine = minePit({
	x = PIT.x,
	z = PIT.z,
	size = PIT.size,
	depth = PIT.depth,
	wall = "px_blackstone",
	wallTint = Color3.fromRGB(120, 114, 120),
	rim = "px_stone_bricks",
	rimTint = Color3.fromRGB(120, 116, 116),
}, core)
do
	-- vines creep over the rim and hang down the pit walls (not over the four ladder shafts in the middle of each side)
	local e = PIT_HALF + B
	for i = 1, 22 do
		local side = (i % 4) + 1
		local t = rng:NextNumber(-PIT_HALF + 4, PIT_HALF - 4)
		if math.abs(t) > 2 * B + 2 then
			local x, z = PIT.x + t, PIT.z + t
			if side == 1 then
				z = PIT.z - e
			elseif side == 2 then
				z = PIT.z + e
			elseif side == 3 then
				x = PIT.x - e
			else
				x = PIT.x + e
			end
			local len = rng:NextInteger(2, 6) * B
			local inward = if side == 1 then 1 elseif side == 2 then -1 else 0
			local inwardX = if side == 3 then 1 elseif side == 4 then -1 else 0
			local vx, vz = x + inwardX * (B + 0.6), z + inward * (B + 0.6)
			decor(box("PitVine", vx - 0.5, -len, vz - 0.5, vx + 0.5, 0.2, vz + 0.5, "px_nether_wart", VINE_DARK, mine))
		end
	end
end
local arrive = folder("Arrival", core)
arrival(SPAWN.x, SPAWN.z, PIT.x, PIT.z, arrive, "px_stone_bricks")
do
	local cf = at(BUYER.x, 0, BUYER.z) * CFrame.Angles(0, math.pi / 2, 0)
