				addOcc(x - 2.5, z - 2.5, x + 2.5, z + 2.5)
				table.insert(poleAt, { x, z, alongX })
				if prev then
					wire(prev[1], anchors[1])
					wire(prev[2], anchors[2])
				end
				prev = anchors
			else
				prev = nil
			end
		end
	end
	-- cocoons on two poles (on the side away from the street)
	for _, c in ipairs({ { -122, -70, -1 }, { 122, -40, 1 } }) do
