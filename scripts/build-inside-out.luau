	decor(lb(cf, "RiftFrame", 2.5, 0, -0.8, 4.5, 12, 0, "px_nether_wart", VINE_RED, r))
	decor(lb(cf, "RiftFrame", -3, 12, -0.8, 3.5, 14.5, 0, "px_nether_wart", VINE_DARK, r))
