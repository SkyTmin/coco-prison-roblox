	local mid = head + Vector3.new(0, 0.6, 0)
	local cf = CFrame.lookAt(mid, mid + Vector3.new(dx, 0.45, dz).Unit)
	decor(part("TelescopeTube", Vector3.new(0.9, 0.9, 4.4), cf, COL.brass, Enum.Material.Metal, f))
