-- ================================================================================ church/05-plan.luau
-- ================================================================ church: the plan shared by every part
local ISLAND = { x = 0, z = -10, rx = 190, rz = 222 } -- an ellipse
local PIT = { x = 0, z = 70, size = 32, depth = 12 }
local PIT_HALF = PIT.size * B / 2 -- 64
local SPAWN = { x = 0, z = 164 }
local BUYER = { x = -32, z = 168 }
local PLAZA = { -104, -44, 104, 196 } -- { x0, z0, x1, z1 } the paved square
local CHURCH = { x0 = -40, x1 = 40, z0 = -190, z1 = -70, floor = 8, portal = { -12, 12 } }
local STEPS = { -24, -70, 24, -48 } -- the wide stair from the portal down to the square
local TOWER = { x0 = 48, x1 = 76, z0 = -98, z1 = -70, top = 180 }
local SUMMIT = { x = 62, z = -84, y = 104 } -- the belfry floor with the bell
local WALKS = { -- { x0, z0, x1, z1 } paths from the square to the bridges
	{ -180, -24, -104, -4 },
	{ 104, -24, 180, -4 },
}
local WEST_ISLE = { x = -266, z = -14, r = 34 }
local EAST_ISLE = { x = 266, z = -14, r = 34 }
local BRIDGES = { { -236, -22, -176, -6 }, { 176, -22, 236, -6 } } -- arched stone bridges at y 0 (the yard part)
local ZONE_CHURCH = { -110, -260, 110, -40 }

local function inRect(x, z, r, pad)
	pad = pad or 0
	return x >= r[1] - pad and x <= r[3] + pad and z >= r[2] - pad and z <= r[4] + pad
end
local function inPitArea(x, z, pad)
	local e = PIT_HALF + 2 * B + (pad or 0)
	return math.abs(x - PIT.x) <= e and math.abs(z - PIT.z) <= e
end
local function onPlaza(x, z, pad)
	return inRect(x, z, PLAZA, pad) and not inPitArea(x, z)
end
local function onPath(x, z, pad)
	pad = pad or 0
	if onPlaza(x, z, pad) then
		return true
	end
	for _, w in ipairs(WALKS) do
		if inRect(x, z, w, pad) then
			return true
		end
	end
	return false
end
local function inChurch(x, z, pad)
	pad = pad or 0
	return x >= CHURCH.x0 - pad
		and x <= CHURCH.x1 + pad
		and z >= CHURCH.z0 - pad
		and z <= CHURCH.z1 + pad
end
local function inTower(x, z, pad)
	pad = pad or 0
	return x >= TOWER.x0 - pad
		and x <= TOWER.x1 + pad
		and z >= TOWER.z0 - pad
		and z <= TOWER.z1 + pad
end
local function inDisc(x, z, c, pad)
	local r = c.r + n2(x, z, 4.4, 0.04) * 6 - (pad or 0)
	return (x - c.x) ^ 2 + (z - c.z) ^ 2 <= r * r
end
-- which island a point is on: "main", "west", "east" or nil (the sky)
local function isleOf(x, z, pad)
	local j = n2(x, z, 4.4, 0.04) * 9 - (pad or 0)
	if ((x - ISLAND.x) / (ISLAND.rx + j)) ^ 2 + ((z - ISLAND.z) / (ISLAND.rz + j)) ^ 2 <= 1 then
		return "main"
	end
	if inDisc(x, z, WEST_ISLE, pad) then
		return "west"
	end
	if inDisc(x, z, EAST_ISLE, pad) then
		return "east"
	end
	return nil
end
local function groundY(x, z)
	return if isleOf(x, z) then 0 else nil
end
-- the part that owns a point: "church", "plaza" or "yard"
local function zoneOf(x, z)
	if inRect(x, z, ZONE_CHURCH) then
		return "church"
	end
	if math.abs(x) < 110 and z >= -40 then
		return "plaza"
	end
	return "yard"
end
-- free ground for props: on an island, off the square and the walks, the pit, the church, the tower and the arrival
local function freeGround(x, z, pad)
	pad = pad or 0
	return isleOf(x, z, 10 + pad) ~= nil
		and not onPath(x, z, 2 + pad)
		and not inPitArea(x, z, 4 + pad)
		and not inChurch(x, z, 8 + pad)
		and not inTower(x, z, 8 + pad)
		and not inRect(x, z, STEPS, 4 + pad)
		and math.sqrt((x - SPAWN.x) ^ 2 + (z - SPAWN.z) ^ 2) > 20 + pad
		and math.sqrt((x - BUYER.x) ^ 2 + (z - BUYER.z) ^ 2) > 14 + pad
end

-- palette: noon over the clouds (tints over already coloured textures stay light)
local WHITE_STONE = Color3.fromRGB(238, 236, 230) -- calcite / diorite look over px_smooth_stone, px_white_stone_bricks
local GREY_STONE = Color3.fromRGB(196, 196, 200)
local SLATE = Color3.fromRGB(70, 80, 120) -- the roofs
local GLASS_BLUE = Color3.fromRGB(50, 100, 200)
local GLASS_CYAN = Color3.fromRGB(90, 180, 225)
local GLASS_WHITE = Color3.fromRGB(225, 235, 245)
local GOLD = Color3.fromRGB(232, 192, 80)
local BANNER_BLUE = Color3.fromRGB(40, 64, 160)
local GRASS = Color3.fromRGB(150, 200, 100)
local CYPRESS = Color3.fromRGB(170, 200, 160) -- a tint over px_hedge (already dark green)
local CLAY = Color3.fromRGB(160, 166, 180)
local CLOUD = Color3.fromRGB(250, 252, 255)

-- ================================================================================ church/10-core.luau
do
-- ================================================================ church: the islands, the ground, the mine, arrival
local core = folder("Core")

-- the ground of a cell: the paved square (smooth white stone with stone brick patches and a darker border), stone
-- bricks under the cathedral and the tower (the church part lays the nave floor on its plinth), grass with moss and
-- dirt patches round the graves elsewhere
local function groundTop(x, z)
	local n = n2(x, z, 3.3, 0.05)
	if inPitArea(x, z) then
		return "px_stone_bricks", GREY_STONE, 0
	end
	if inChurch(x, z, 8) or inTower(x, z, 8) or inRect(x, z, STEPS) then
		return "px_white_stone_bricks", WHITE_STONE, 0
	end
	if onPath(x, z) then
		local edge = not onPath(x, z, -8)
		if edge then
			return "px_stone_bricks", GREY_STONE, 0
		end
		return if n > 0.3 then "px_stone_bricks" else "px_smooth_stone", WHITE_STONE, 0
	end
	if n > 0.36 then
		return "px_mossy_cobblestone", nil, 0
	end
	if n < -0.38 then
		return "px_dirt", nil, 0
	end
	return "px_grass_top", GRASS, 0
end
-- the islands hang as tall blocks of white stone (16-stud steps), ragged near the rim
local function rockDepth(x, z)
	local isle = isleOf(x, z)
	local rr, deep
	if isle == "main" then
		rr = math.sqrt(((x - ISLAND.x) / ISLAND.rx) ^ 2 + ((z - ISLAND.z) / ISLAND.rz) ^ 2)
		deep = 150
	else
		local c = if isle == "west" then WEST_ISLE else EAST_ISLE
		rr = math.sqrt((x - c.x) ^ 2 + (z - c.z) ^ 2) / c.r
		deep = 56
	end
	rr = math.clamp(rr, 0, 1)
	local d = 16 + (1 - rr) ^ 1.2 * deep
	if rr > 0.82 then
		d += (n2(x, z, 7.7, 0.09) + 0.5) * 28
	end
	return math.max(8, math.floor(d / 16 + 0.5) * 16)
end
local _, islandRuns = island({
	pit = PIT, -- the mine hole stays open
	x0 = -312,
	x1 = 312,
	z0 = -248,
	z1 = 232,
	cell = 8,
	shape = function(x, z)
		return isleOf(x, z) ~= nil
	end,
	top = groundTop,
	depth = rockDepth,
	rockTop = "px_stone",
	rockTopTint = Color3.fromRGB(226, 226, 228),
	rockLow = "px_stone",
	rockLowTint = Color3.fromRGB(198, 200, 208),
}, core)
task.wait()

-- ================================================================ the mine of clay in the square
local mine = minePit({
	x = PIT.x,
	z = PIT.z,
	size = PIT.size,
	depth = PIT.depth,
	wall = "px_red_brick",
	rim = "px_stone_bricks",
	rimTint = GREY_STONE,
}, core)
local arrive = folder("Arrival", core)
arrival(SPAWN.x, SPAWN.z, PIT.x, PIT.z, arrive, "px_white_stone_bricks")
do
	local cf = at(BUYER.x, 0, BUYER.z) * CFrame.Angles(0, -math.pi / 2, 0)
	stall(cf, {
		w = 4 * B,
		d = 2 * B,
		colA = BANNER_BLUE,
		colB = Color3.fromRGB(240, 240, 236),
		goods = { "px_smooth_stone", "px_smooth_stone", "px_smooth_stone" },
		sign = "Скупка",
	}, arrive)
	buyer(
		cf * CFrame.new(0, 3, 1.4),
		{ shirt = Color3.fromRGB(40, 60, 130), pants = Color3.fromRGB(60, 60, 70) },
		arrive
	)
	crate(BUYER.x - 4, 0, BUYER.z + 10, arrive)
	barrel(BUYER.x + 2, 0, BUYER.z + 10, arrive)
	zoneSign(SPAWN.x + 14, SPAWN.z + 8, "Церковь", math.pi, arrive)
end

-- ================================================================ the void net, the edge walls (noon: no lighting volume)
do
	local net = part("VoidCatch", Vector3.new(900, 10, 800), at(0, -260, -8), nil, nil, core)
	net.Transparency = 1
	net.CanCollide = false
	net.CanTouch = false
	net.CastShadow = false
	net:SetAttribute("LocationId", LOC)
	CollectionService:AddTag(net, "VoidCatch")
	-- one box round the whole cluster: the gaps between the islands are open sky (a fall goes back to the arrival)
	edgeWalls(
		{ { 0, -262, 648, 4 }, { 0, 246, 648, 4 }, { -326, -8, 4, 512 }, { 326, -8, 4, 512 } },
		core
	)
end
print(("[build-church] core: island runs %d"):format(islandRuns))

end
task.wait()
-- ================================================================================ church/20-cathedral.luau
do
-- ================================================================ church: the cathedral, the steps, the bell tower
-- The PLINTH x -40..40, z -190..-70, y 0..8 (white stone bricks, a grey course y 6..8 = the nave floor level). The
-- STEPS x -24..24 from the portal (z -70, y 8) down to the square (z -48, y 0): kit stairs on a fill, cheek walls
-- x ±24..28 with candles, two lantern pillars at x ±32, z -50.
-- The NAVE x -20..20 (10 blocks) inside, z -166..-78, floor y 8 (a blue-and-white mosaic, lattice down the aisle
-- x -8..8 and over the crossing z -166..-138); PIERS 2×2 blocks at x ±20..28 every 5 blocks (centres z -82, -102,
