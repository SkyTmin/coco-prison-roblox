	box("OrganBench", 8, 8, -155, 9.6, 10, -149, "px_spruce_planks", nil, f)
	for n, h in ipairs({ 8, 12, 16, 16, 12, 8 }) do
		local z0 = -158 + 2 * (n - 1)
		box("OrganPipe", 14, 20, z0, 16, 20 + h, z0 + 2, "px_iron_block", nil, f)
