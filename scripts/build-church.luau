				{ 137.5, 142.5, 9, 10.5 },
				{ 139, 141, 10.5, 11.5 },
			}) do
				mb(
					"MausoleumDoor",
					d[1],
					d[3],
					zn + dz * 0.8,
					d[2],
					d[4],
