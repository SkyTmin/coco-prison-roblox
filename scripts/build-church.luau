		candles(x, y0 + 7, z, lit, f)
	end
	for _, sx in ipairs({ -1, 1 }) do
		stand(sx * 14, 8, -84, false)
		stand(sx * 10, 8, -144, true)
		stand(sx * 10, 8, -164, false)
		stand(sx * 10, 9, -176, true)
