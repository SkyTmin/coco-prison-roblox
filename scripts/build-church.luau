					WHITE_STONE,
					true
				)
			end
			mb(
				"MausoleumCross",
				139,
				20.5,
				zn - dz * 3,
				141,
				27,
				zn - dz * 1,
				"px_smooth_stone",
				WHITE_STONE,
				true
			)
			mb(
				"MausoleumCross",
				136.5,
				23.5,
				zn - dz * 3,
				143.5,
				25,
				zn - dz * 1,
				"px_smooth_stone",
				WHITE_STONE,
				true
			)
			-- the pointed door in a white frame
			mb(
				"MausoleumDoorFrame",
				134,
				1,
				zn,
				146,
				12,
				zn + dz * 0.8,
				"px_smooth_stone",
				WHITE_STONE,
				true
			)
			local dark = Color3.fromRGB(120, 105, 95)
			for _, d in ipairs({
