	local f = folder("Telescope", parent)
	local head = V(x, 4.2, z)
	for i = 0, 2 do
		local a = i * 2 * math.pi / 3 + 0.3
		decor(
			beam(
				"TelescopeLeg",
				head,
				V(x + math.cos(a) * 1.6, 0, z + math.sin(a) * 1.6),
