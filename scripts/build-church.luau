-- the mine pit: walls, rim, four ladder shafts and the MineAnchor (MineService fills it); size/depth in blocks
local function minePit(opt, parent)
	local mine = folder("Mine", parent)
	local size, depth = opt.size or 32, opt.depth or 12
	local w, h = size * B, depth * B
	local mx, mz = opt.x, opt.z
	local wallV, rimV = opt.wall or "px_stone_bricks", opt.rim or "px_cobblestone"
	box("PitFloor", mx - w / 2 - 2 * B, -h - B, mz - w / 2 - 2 * B, mx + w / 2 + 2 * B, -h, mz + w / 2 + 2 * B, wallV, opt.wallTint, mine)
	box("PitWall", mx - w / 2 - 2 * B, -h, mz - w / 2 - 2 * B, mx + w / 2 + 2 * B, 0, mz - w / 2, wallV, opt.wallTint, mine)
	box("PitWall", mx - w / 2 - 2 * B, -h, mz + w / 2, mx + w / 2 + 2 * B, 0, mz + w / 2 + 2 * B, wallV, opt.wallTint, mine)
	box("PitWall", mx - w / 2 - 2 * B, -h, mz - w / 2, mx - w / 2, 0, mz + w / 2, wallV, opt.wallTint, mine)
	box("PitWall", mx + w / 2, -h, mz - w / 2, mx + w / 2 + 2 * B, 0, mz + w / 2, wallV, opt.wallTint, mine)
	-- the rim one block above the market floor would trip players: it sits flush, a darker border
	for _, r in ipairs({
		{ mx - w / 2 - 2 * B, mz - w / 2 - 2 * B, mx + w / 2 + 2 * B, mz - w / 2 },
		{ mx - w / 2 - 2 * B, mz + w / 2, mx + w / 2 + 2 * B, mz + w / 2 + 2 * B },
		{ mx - w / 2 - 2 * B, mz - w / 2, mx - w / 2, mz + w / 2 },
		{ mx + w / 2, mz - w / 2, mx + w / 2 + 2 * B, mz + w / 2 },
	}) do
		box("PitRim", r[1], -0.2, r[2], r[3], 0.4, r[4], rimV, opt.rimTint, mine)
	end
	local anchor = part("MineAnchor_" .. LOC, Vector3.new(w, 0.2, w), at(mx, -0.1, mz), nil, nil, mine)
	anchor.Transparency = 1
	anchor:SetAttribute("LocationId", LOC)
	anchor:SetAttribute("MineId", LOC)
	anchor:SetAttribute("Size", Vector3.new(size, depth, size))
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.CanCollide = false
	CollectionService:AddTag(anchor, "MineAnchor")
	sign(anchor, "Шахта", 14)
	-- four 4-block ladder shafts, one per wall (MineService keeps them free)
	local LADDER_W = 4 * B
	for _, side in ipairs({
		{ mx, mz - w / 2, Vector3.new(0, 0, 1) },
		{ mx, mz + w / 2, Vector3.new(0, 0, -1) },
		{ mx - w / 2, mz, Vector3.new(1, 0, 0) },
		{ mx + w / 2, mz, Vector3.new(-1, 0, 0) },
	}) do
		local inward = side[3]
		local along = Vector3.new(math.abs(inward.Z), 0, math.abs(inward.X))
		local base = V(side[1], -h / 2, side[2])
		for k = 0, LADDER_W / 2 - 1 do
			local truss = Instance.new("TrussPart")
			truss.Name = "Ladder"
			truss.Size = Vector3.new(2, h, 2)
			truss.CFrame = CFrame.new(base - inward * 0.6 + along * (-LADDER_W / 2 + 1 + k * 2))
			truss.Anchored = true
			truss.Transparency = 1
			truss.Parent = mine
		end
		local plate = Instance.new("Part")
		plate.Name = "LadderFace"
		plate.Size = Vector3.new(LADDER_W * along.X + 0.2 * math.abs(inward.X), h, LADDER_W * along.Z + 0.2 * math.abs(inward.Z))
		plate.CFrame = CFrame.new(base + inward * 0.15)
		plate.Anchored = true
		plate.CanCollide = false
		plate.CanQuery = false
		plate.Transparency = 1
		plate.Parent = mine
		if TEX.ladder then
			local tex = Instance.new("Texture")
			tex.Texture = TEX.ladder
			tex.Face = if inward.Z > 0 then Enum.NormalId.Back elseif inward.Z < 0 then Enum.NormalId.Front elseif inward.X > 0 then Enum.NormalId.Right else Enum.NormalId.Left
			tex.StudsPerTileU, tex.StudsPerTileV = B, B
			tex.Parent = plate
		end
	end
	return mine
end
-- the arrival point (LocationSpawn) at (x, z) looking toward (lx, lz)
local function arrival(x, z, lx, lz, parent, variant)
	local spawn = part("LocationSpawn_" .. LOC, Vector3.new(4, 1, 4), CFrame.lookAt(V(x, 0.5, z), V(lx, 0.5, lz)), nil, nil, parent)
	textured(spawn, variant or WOOD)
	spawn:SetAttribute("LocationId", LOC)
	CollectionService:AddTag(spawn, "LocationSpawn")
	return spawn
end
-- an anchored R15 NPC; tag e.g. "SellPoint" (the block buyer); returns the model
local function npc(name, cf, opt, parent)
	opt = opt or {}
	local desc = Instance.new("HumanoidDescription")
	local skin = opt.skin or Color3.fromRGB(220, 180, 150)
	desc.HeadColor, desc.LeftArmColor, desc.RightArmColor = skin, skin, skin
	desc.TorsoColor = opt.shirt or Color3.fromRGB(120, 90, 60)
	desc.LeftLegColor = opt.pants or Color3.fromRGB(70, 60, 50)
	desc.RightLegColor = opt.pants or Color3.fromRGB(70, 60, 50)
	local model = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	model.Name = name
	local animate = model:FindFirstChild("Animate")
	if animate then
		animate:Destroy()
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored = true
		end
	end
	model.Parent = parent or root
	model:PivotTo(cf)
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if opt.tag then
		CollectionService:AddTag(hrp, opt.tag)
	end
	if opt.label then
		sign(hrp, opt.label, 4.5, opt.labelColor, 60)
	end
	return model
end
-- the block buyer (SellPoint), red name like every buyer [владелец 21.10]
local function buyer(cf, opt, parent)
	opt = opt or {}
	opt.tag = "SellPoint"
	opt.label = "Скупщик блоков"
	opt.labelColor = Color3.fromRGB(255, 55, 55)
	return npc("Buyer", cf, opt, parent)
end
-- the boss spawn (BossService); y local, radius = arena radius for the leash
local function bossSpawn(bossId, x, y, z, radius, parent)
	local p = part("BossSpawn", Vector3.new(4, 1, 4), at(x, y, z), nil, nil, parent)
	p.Transparency = 1
	p.CanCollide = false
	p.CanQuery = false
	p:SetAttribute("BossId", bossId)
	p:SetAttribute("ArenaRadius", radius)
	CollectionService:AddTag(p, "BossSpawn")
	return p
end
-- a stun pillar for the boss charge (BossService: parts tagged Pillar stop the charge and stun)
local function pillarTag(p)
	CollectionService:AddTag(p, "Pillar")
	return p
end
-- invisible edge walls (no falling off the floating island): list of {x, z, sx, sz} local
local function edgeWalls(list, parent)
	for _, w in ipairs(list) do
		local p = part("EdgeWall", Vector3.new(w[3], 400, w[4]), at(w[1], 150, w[2]), nil, nil, parent)
		p.Transparency = 1
		p.CanQuery = false
		p.CanTouch = false
	end
end
-- a lighting volume read by src/client/IndoorLighting.luau (Ambient, Exposure, Haze, ClockTime, Brightness,
-- AtmosphereColor, AtmosphereDecay)
local function lightingVolume(name, cx, cy, cz, sx, sy, sz, attrs, parent)
	local model = Instance.new("Model")
	model.Name = "IndoorLighting"
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	model.Parent = parent or root
	local v = decor(part(name, Vector3.new(sx, sy, sz), at(cx, cy, cz), nil, nil, model))
	v.Transparency = 1
	for k, val in pairs(attrs) do
		v:SetAttribute(k, val)
	end
	CollectionService:AddTag(v, "IndoorLighting")
	return v
end

-- ================================================================ the floating island (8-stud cells)
-- opt.shape(x, z) -> true on land; opt.top(x, z) -> variant, tint, y (the top surface height, local); opt.depth(x, z)
-- -> studs of rock below the ground block. The column is: ground (1 block, the top variant), rock (24 studs,
-- opt.rockTop) and below that opt.rockLow down to the depth. opt.voids = { {x0, x1, z0, z1, y0, y1} or
-- {cx, cz, r, y0, y1, circle = true} }: carved out of the column (crypts, tunnels, holes) — the parts that live
-- there are built by the location itself. opt.pit = PIT ({x, z, size, depth}): the mine hole is carved out too (half a
-- cell wider, under the pit walls) so the mine blocks are not buried in rock. Equal neighbouring cells along x are
-- merged into one run.
local function island(opt, parent)
	local f = folder("Island", parent)
	local C = opt.cell or 8
	local x0, x1, z0, z1 = opt.x0, opt.x1, opt.z0, opt.z1
	local voids = table.clone(opt.voids or {})
	if opt.pit then
		local p = opt.pit
		local e = p.size * B / 2 + C / 2
		table.insert(voids, { p.x - e, p.x + e, p.z - e, p.z + e, -p.depth * B, 2 * B })
	end
	local runs = 0
	-- the column segments of one cell: { {ya, yb, layer}, ... } with layer 1 ground, 2 rock, 3 low rock
	local function column(cx, cz)
		local var, tint, y = opt.top(cx, cz)
		local d = math.floor(opt.depth(cx, cz) / B + 0.5) * B
		local segs = { { y - B, y, 1 } }
		if d > 0 then
			table.insert(segs, { y - B - math.min(d, 24), y - B, 2 })
			if d > 24 then
				table.insert(segs, { y - B - d, y - B - 24, 3 })
			end
		end
		for _, v in ipairs(voids) do
			local inside, vy0, vy1
			if v.circle then
				inside = (cx - v[1]) ^ 2 + (cz - v[2]) ^ 2 <= v[3] * v[3]
				vy0, vy1 = v[4], v[5]
			else
				inside = cx >= v[1] and cx <= v[2] and cz >= v[3] and cz <= v[4]
				vy0, vy1 = v[5], v[6]
			end
			if inside then
				local cut = {}
				for _, s in ipairs(segs) do
					if s[2] <= vy0 or s[1] >= vy1 then
						table.insert(cut, s)
					else
						if s[1] < vy0 then
							table.insert(cut, { s[1], vy0, s[3] })
						end
						if s[2] > vy1 then
							table.insert(cut, { vy1, s[2], s[3] })
						end
					end
				end
				segs = cut
			end
		end
		local key = tostring(var) .. "|" .. tostring(tint)
		for _, s in ipairs(segs) do
			key ..= "|" .. s[1] .. ":" .. s[2] .. ":" .. s[3]
		end
		return key, segs, var, tint
	end
	for z = z0, z1 - C, C do
		local runStart, runKey, runSegs, runVar, runTint = nil, nil, nil, nil, nil
		local function flush(xEnd)
			if runStart then
				for _, s in ipairs(runSegs) do
					local name, variant, tint = "Ground", runVar, runTint
					if s[3] == 2 then
						name, variant, tint = "Rock", opt.rockTop or "px_stone", opt.rockTopTint
					elseif s[3] == 3 then
						name, variant, tint = "RockLow", opt.rockLow or "px_cobblestone", opt.rockLowTint
					end
					if s[2] - s[1] > 0.05 then
						box(name, runStart, s[1], z, xEnd, s[2], z + C, variant, tint, f)
					end
				end
				runs += 1
				if runs % 300 == 0 then
					task.wait()
				end
			end
			runStart = nil
		end
		for x = x0, x1 - C, C do
			local cx, cz = x + C / 2, z + C / 2
			if opt.shape(cx, cz) then
				local key, segs, var, tint = column(cx, cz)
				if key ~= runKey then
					flush(x)
					runStart, runKey, runSegs, runVar, runTint = x, key, segs, var, tint
				end
			else
				flush(x)
				runKey = nil
			end
		end
		flush(x1)
	end
	return f, runs
end

-- ================================================================ the location parts follow (scripts/locations/<id>/*.luau)

-- ================================================================================ church/05-plan.luau
-- ================================================================ church: the plan shared by every part
local ISLAND = { x = 0, z = -10, rx = 190, rz = 222 } -- an ellipse
local PIT = { x = 0, z = 70, size = 32, depth = 12 }
local PIT_HALF = PIT.size * B / 2 -- 64
local SPAWN = { x = 0, z = 164 }
local BUYER = { x = -32, z = 168 }
local PLAZA = { -104, -44, 104, 196 } -- { x0, z0, x1, z1 } the paved square
local CHURCH = { x0 = -40, x1 = 40, z0 = -190, z1 = -70, floor = 8, portal = { -12, 12 } }
local STEPS = { -24, -70, 24, -48 } -- the wide stair from the portal down to the square
local TOWER = { x0 = 48, x1 = 76, z0 = -98, z1 = -70, top = 180 }
local SUMMIT = { x = 62, z = -84, y = 104 } -- the belfry floor with the bell
local WALKS = { -- { x0, z0, x1, z1 } paths from the square to the bridges
	{ -180, -24, -104, -4 },
	{ 104, -24, 180, -4 },
}
local WEST_ISLE = { x = -266, z = -14, r = 34 }
local EAST_ISLE = { x = 266, z = -14, r = 34 }
local BRIDGES = { { -236, -22, -176, -6 }, { 176, -22, 236, -6 } } -- arched stone bridges at y 0 (the yard part)
local ZONE_CHURCH = { -110, -260, 110, -40 }

local function inRect(x, z, r, pad)
	pad = pad or 0
	return x >= r[1] - pad and x <= r[3] + pad and z >= r[2] - pad and z <= r[4] + pad
end
local function inPitArea(x, z, pad)
	local e = PIT_HALF + 2 * B + (pad or 0)
	return math.abs(x - PIT.x) <= e and math.abs(z - PIT.z) <= e
end
local function onPlaza(x, z, pad)
	return inRect(x, z, PLAZA, pad) and not inPitArea(x, z)
end
local function onPath(x, z, pad)
	pad = pad or 0
	if onPlaza(x, z, pad) then
		return true
	end
	for _, w in ipairs(WALKS) do
		if inRect(x, z, w, pad) then
			return true
		end
	end
	return false
end
local function inChurch(x, z, pad)
	pad = pad or 0
	return x >= CHURCH.x0 - pad
		and x <= CHURCH.x1 + pad
		and z >= CHURCH.z0 - pad
		and z <= CHURCH.z1 + pad
end
local function inTower(x, z, pad)
	pad = pad or 0
	return x >= TOWER.x0 - pad
		and x <= TOWER.x1 + pad
		and z >= TOWER.z0 - pad
		and z <= TOWER.z1 + pad
end
local function inDisc(x, z, c, pad)
	local r = c.r + n2(x, z, 4.4, 0.04) * 6 - (pad or 0)
	return (x - c.x) ^ 2 + (z - c.z) ^ 2 <= r * r
end
-- which island a point is on: "main", "west", "east" or nil (the sky)
local function isleOf(x, z, pad)
	local j = n2(x, z, 4.4, 0.04) * 9 - (pad or 0)
	if ((x - ISLAND.x) / (ISLAND.rx + j)) ^ 2 + ((z - ISLAND.z) / (ISLAND.rz + j)) ^ 2 <= 1 then
		return "main"
	end
	if inDisc(x, z, WEST_ISLE, pad) then
		return "west"
	end
	if inDisc(x, z, EAST_ISLE, pad) then
		return "east"
	end
	return nil
end
local function groundY(x, z)
	return if isleOf(x, z) then 0 else nil
end
-- the part that owns a point: "church", "plaza" or "yard"
local function zoneOf(x, z)
	if inRect(x, z, ZONE_CHURCH) then
		return "church"
	end
	if math.abs(x) < 110 and z >= -40 then
		return "plaza"
	end
	return "yard"
end
-- free ground for props: on an island, off the square and the walks, the pit, the church, the tower and the arrival
local function freeGround(x, z, pad)
	pad = pad or 0
	return isleOf(x, z, 10 + pad) ~= nil
		and not onPath(x, z, 2 + pad)
		and not inPitArea(x, z, 4 + pad)
		and not inChurch(x, z, 8 + pad)
		and not inTower(x, z, 8 + pad)
		and not inRect(x, z, STEPS, 4 + pad)
		and math.sqrt((x - SPAWN.x) ^ 2 + (z - SPAWN.z) ^ 2) > 20 + pad
		and math.sqrt((x - BUYER.x) ^ 2 + (z - BUYER.z) ^ 2) > 14 + pad
end

-- palette: noon over the clouds (tints over already coloured textures stay light)
local WHITE_STONE = Color3.fromRGB(238, 236, 230) -- calcite / diorite look over px_smooth_stone, px_white_stone_bricks
local GREY_STONE = Color3.fromRGB(196, 196, 200)
local SLATE = Color3.fromRGB(70, 80, 120) -- the roofs
local GLASS_BLUE = Color3.fromRGB(50, 100, 200)
local GLASS_CYAN = Color3.fromRGB(90, 180, 225)
local GLASS_WHITE = Color3.fromRGB(225, 235, 245)
local GOLD = Color3.fromRGB(232, 192, 80)
local BANNER_BLUE = Color3.fromRGB(40, 64, 160)
local GRASS = Color3.fromRGB(150, 200, 100)
local CYPRESS = Color3.fromRGB(170, 200, 160) -- a tint over px_hedge (already dark green)
local CLAY = Color3.fromRGB(160, 166, 180)
local CLOUD = Color3.fromRGB(250, 252, 255)

-- ================================================================================ church/10-core.luau
do
-- ================================================================ church: the islands, the ground, the mine, arrival
local core = folder("Core")

-- the ground of a cell: the paved square (smooth white stone with stone brick patches and a darker border), stone
-- bricks under the cathedral and the tower (the church part lays the nave floor on its plinth), grass with moss and
-- dirt patches round the graves elsewhere
local function groundTop(x, z)
	local n = n2(x, z, 3.3, 0.05)
	if inPitArea(x, z) then
		return "px_stone_bricks", GREY_STONE, 0
	end
	if inChurch(x, z, 8) or inTower(x, z, 8) or inRect(x, z, STEPS) then
		return "px_white_stone_bricks", WHITE_STONE, 0
	end
	if onPath(x, z) then
		local edge = not onPath(x, z, -8)
		if edge then
			return "px_stone_bricks", GREY_STONE, 0
		end
		return if n > 0.3 then "px_stone_bricks" else "px_smooth_stone", WHITE_STONE, 0
	end
	if n > 0.36 then
		return "px_mossy_cobblestone", nil, 0
	end
	if n < -0.38 then
		return "px_dirt", nil, 0
	end
	return "px_grass_top", GRASS, 0
end
-- the islands hang as tall blocks of white stone (16-stud steps), ragged near the rim
local function rockDepth(x, z)
	local isle = isleOf(x, z)
	local rr, deep
	if isle == "main" then
		rr = math.sqrt(((x - ISLAND.x) / ISLAND.rx) ^ 2 + ((z - ISLAND.z) / ISLAND.rz) ^ 2)
		deep = 150
	else
		local c = if isle == "west" then WEST_ISLE else EAST_ISLE
		rr = math.sqrt((x - c.x) ^ 2 + (z - c.z) ^ 2) / c.r
		deep = 56
	end
	rr = math.clamp(rr, 0, 1)
	local d = 16 + (1 - rr) ^ 1.2 * deep
	if rr > 0.82 then
		d += (n2(x, z, 7.7, 0.09) + 0.5) * 28
	end
	return math.max(8, math.floor(d / 16 + 0.5) * 16)
end
local _, islandRuns = island({
	pit = PIT, -- the mine hole stays open
	x0 = -312,
	x1 = 312,
	z0 = -248,
	z1 = 232,
	cell = 8,
	shape = function(x, z)
		return isleOf(x, z) ~= nil
	end,
	top = groundTop,
	depth = rockDepth,
	rockTop = "px_stone",
	rockTopTint = Color3.fromRGB(226, 226, 228),
	rockLow = "px_stone",
	rockLowTint = Color3.fromRGB(198, 200, 208),
}, core)
task.wait()

-- ================================================================ the mine of clay in the square
local mine = minePit({
	x = PIT.x,
	z = PIT.z,
	size = PIT.size,
	depth = PIT.depth,
	wall = "px_red_brick",
	rim = "px_stone_bricks",
	rimTint = GREY_STONE,
}, core)
local arrive = folder("Arrival", core)
arrival(SPAWN.x, SPAWN.z, PIT.x, PIT.z, arrive, "px_white_stone_bricks")
do
	local cf = at(BUYER.x, 0, BUYER.z) * CFrame.Angles(0, -math.pi / 2, 0)
	stall(cf, {
		w = 4 * B,
		d = 2 * B,
		colA = BANNER_BLUE,
		colB = Color3.fromRGB(240, 240, 236),
		goods = { "px_smooth_stone", "px_smooth_stone", "px_smooth_stone" },
		sign = "Скупка",
	}, arrive)
	buyer(
		cf * CFrame.new(0, 3, 1.4),
		{ shirt = Color3.fromRGB(40, 60, 130), pants = Color3.fromRGB(60, 60, 70) },
		arrive
	)
	crate(BUYER.x - 4, 0, BUYER.z + 10, arrive)
	barrel(BUYER.x + 2, 0, BUYER.z + 10, arrive)
	zoneSign(SPAWN.x + 14, SPAWN.z + 8, "Церковь", math.pi, arrive)
end

-- ================================================================ the void net, the edge walls (noon: no lighting volume)
do
	local net = part("VoidCatch", Vector3.new(900, 10, 800), at(0, -260, -8), nil, nil, core)
	net.Transparency = 1
	net.CanCollide = false
	net.CanTouch = false
	net.CastShadow = false
	net:SetAttribute("LocationId", LOC)
	CollectionService:AddTag(net, "VoidCatch")
	-- one box round the whole cluster: the gaps between the islands are open sky (a fall goes back to the arrival)
	edgeWalls(
		{ { 0, -262, 648, 4 }, { 0, 246, 648, 4 }, { -326, -8, 4, 512 }, { 326, -8, 4, 512 } },
		core
	)
end
print(("[build-church] core: island runs %d"):format(islandRuns))

end
task.wait()
local total = #root:GetDescendants()
print(("[build-church] built: %d instances, %d parts"):format(total, count))
return ("built %d instances, %d parts"):format(total, count)
