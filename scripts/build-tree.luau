			CFrame.new(pos + Vector3.new(0, 0.62, 0)),
			IRON,
			metal,
			parent
		)
	)
	for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }) do
		decor(
			part(
				"LanternBar",
				Vector3.new(0.2, 1, 0.2),
				CFrame.new(pos + Vector3.new(c[1] * 0.55, 0, c[2] * 0.55)),
