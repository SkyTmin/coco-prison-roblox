-- a lamp post counted against the light budget
local function lampPostL(x, z, parent, yaw)
	local f = folder("LampPost", parent)
	lampPost(x, z, f, false, yaw)
	lit += 1
	if lit > 20 then
		for _, d in ipairs(f:GetDescendants()) do
			if d:IsA("PointLight") then
				d:Destroy()
			end
		end
