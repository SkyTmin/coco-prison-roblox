				g.Material = Enum.Material.Glass
				g.Color = GLASS
				g.Transparency = 0.4
			end
			for _, l in ipairs(SAND_L) do
				decor(hb("HourglassSand", l[3], l[1], l[2], "px_sand", SAND))
			end
		end
