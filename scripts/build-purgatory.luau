		-- a giant hourglass (s = 1: 3×3 blocks, 6 high): dark oak plates and posts, glass bulbs, sand, gold caps
		local GLASS_L = {
			{ 2.6, 6, 8 },
			{ 6, 9, 6 },
			{ 9, 11, 4 },
			{ 11, 13, 2 },
			{ 13, 15, 4 },
			{ 15, 18, 6 },
			{ 18, 21.4, 8 },
