-- a Minecraft lantern: a small iron-framed glowing block; hanging = with a chain up to `hangTop` (world y)
local function lantern(pos, parent, soul, hangTop)
	local glow = if soul then SOUL_GLOW else LANTERN_GLOW
	local cage = part("Lantern", Vector3.new(1.3, 1.5, 1.3), CFrame.new(pos), Color3.fromRGB(45, 45, 50), Enum.Material.Metal, parent)
	local core = decor(part("LanternGlow", Vector3.new(0.9, 1, 0.9), CFrame.new(pos), glow, Enum.Material.Neon, parent))
	core.Transparency = 0.1
	decor(part("LanternCap", Vector3.new(0.7, 0.35, 0.7), CFrame.new(pos + Vector3.new(0, 0.9, 0)), Color3.fromRGB(40, 40, 45), Enum.Material.Metal, parent))
	if hangTop and hangTop > pos.Y + 1 then
		decor(part("Chain", Vector3.new(0.25, hangTop - pos.Y - 0.9, 0.25), CFrame.new(pos.X, (hangTop + pos.Y + 0.9) / 2, pos.Z), Color3.fromRGB(55, 55, 60), Enum.Material.Metal, parent))
	end
	light(core, 30, 1.2, glow)
	return cage
end
-- a lamp post (fence-post style) with a hanging lantern on an arm
local function lampPost(x, z, parent, soul, yaw, y0)
	y0 = y0 or 0
	local cf = at(x, y0, z) * CFrame.Angles(0, yaw or 0, 0)
	textured(part("LampBase", Vector3.new(B, 1, B), cf * CFrame.new(0, 0.5, 0), nil, nil, parent), "px_stone_bricks")
	textured(part("LampPost", Vector3.new(1, 9, 1), cf * CFrame.new(0, 5.5, 0), nil, nil, parent), WOOD_DARK)
	textured(part("LampArm", Vector3.new(1, 1, 3.5), cf * CFrame.new(0, 9.5, -1.5), nil, nil, parent), WOOD_DARK)
	local p = (cf * CFrame.new(0, 7.3, -2.8)).Position
	lantern(p, parent, soul, p.Y + 2.2)
end
local function barrel(x, y, z, parent, topVariant)
	local p = cube("Barrel", x, y + 2, z, B, B, B, "px_spruce_planks", Color3.fromRGB(150, 110, 80), parent)
	for _, h in ipairs({ 0.6, 3.4 }) do
		decor(part("Hoop", Vector3.new(B + 0.1, 0.3, B + 0.1), at(x, y + h, z), Color3.fromRGB(70, 70, 75), Enum.Material.Metal, parent))
	end
	if topVariant then
		textured(decor(part("BarrelGoods", Vector3.new(B - 0.6, 0.5, B - 0.6), at(x, y + B + 0.25, z), nil, nil, parent)), topVariant)
