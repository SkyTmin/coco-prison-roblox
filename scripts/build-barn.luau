-- ================================================================================ barn/05-plan.luau
-- ================================================================ barn: the plan shared by every part
local ISLAND_R = 216
local PIT = { x = 0, z = 96, size = 32, depth = 12 }
local PIT_HALF = PIT.size * B / 2 -- 64
local SPAWN = { x = 0, z = 190 }
local BUYER = { x = 36, z = 192 }
local BARN = { x0 = -52, x1 = 52, z0 = -72, z1 = 4, tree = { x = 16, z = -32 } }
local ARENA = { x = 0, z = -140, r = 52 }
local GUARDIAN = { x = 0, z = -204 }
local RING_IN = { -72, 24, 72, 168 } -- the pit area (pit + rim)
local RING_OUT = { -92, 4, 92, 188 }
local PATHS = { -- { x0, z0, x1, z1 }
	{ -96, -84, -72, 4 }, -- round the barn, west
	{ 72, -84, 96, 4 }, -- round the barn, east
	{ -216, -24, -92, -8 }, -- west
	{ 92, -24, 216, -8 }, -- east
	{ -10, 188, 10, 216 }, -- the south stair
}
local ZONE_BARN = { -84, -80, 84, 4 }

local function inRect(x, z, r, pad)
	pad = pad or 0
	return x >= r[1] - pad and x <= r[3] + pad and z >= r[2] - pad and z <= r[4] + pad
end
local function inPitArea(x, z, pad)
	local e = PIT_HALF + 2 * B + (pad or 0)
	return math.abs(x - PIT.x) <= e and math.abs(z - PIT.z) <= e
end
local function onPath(x, z, pad)
	pad = pad or 0
	if inRect(x, z, RING_OUT, pad) and not inRect(x, z, RING_IN, -pad) then
		return true
	end
	for _, p in ipairs(PATHS) do
		if inRect(x, z, p, pad) then
			return true
		end
	end
	return false
end
local function inArena(x, z, pad)
	return (x - ARENA.x) ^ 2 + (z - ARENA.z) ^ 2 <= (ARENA.r + (pad or 0)) ^ 2
end
local function inBarn(x, z, pad)
	pad = pad or 0
	return x >= BARN.x0 - pad and x <= BARN.x1 + pad and z >= BARN.z0 - pad and z <= BARN.z1 + pad
end
local function onIsland(x, z, pad)
	-- a hexagon-ish outline: the radius swells toward six lobes and is ragged
	local a = math.atan2(z, x)
	local r = ISLAND_R + math.cos(a * 6 + 0.4) * 8 + n2(x, z, 4.4, 0.03) * 10 - (pad or 0)
	return x * x + z * z <= r * r
end
-- the part that owns a point: "barn", "yard" or "outskirts"
local function zoneOf(x, z)
	if inRect(x, z, ZONE_BARN) then
		return "barn"
	end
	if z < -80 then
		return "yard"
	end
	return "outskirts"
end
-- free ground for props: on the island, off the paths, the pit, the barn, the arena and the arrival
local function freeGround(x, z, pad)
	pad = pad or 0
	return onIsland(x, z, 10 + pad)
		and not onPath(x, z, 2 + pad)
		and not inPitArea(x, z, 4 + pad)
		and not inBarn(x, z, 4 + pad)
		and not inArena(x, z, 6 + pad)
		and math.sqrt((x - SPAWN.x) ^ 2 + (z - SPAWN.z) ^ 2) > 20 + pad
		and math.sqrt((x - BUYER.x) ^ 2 + (z - BUYER.z) ^ 2) > 14 + pad
end

-- palette: autumn dusk, orange pumpkin light
local WEEDS = Color3.fromRGB(150, 140, 80)
local PODZOL = Color3.fromRGB(120, 88, 60)
local PATH_DIRT = Color3.fromRGB(140, 104, 72)
local BARN_RED = Color3.fromRGB(150, 52, 44)
local OLD_WOOD = Color3.fromRGB(110, 86, 64)
local RUST = Color3.fromRGB(170, 90, 50)
local AUTUMN = Color3.fromRGB(214, 110, 40)
local AUTUMN_DEEP = Color3.fromRGB(170, 70, 30)
local PUMPKIN = Color3.fromRGB(236, 140, 40)
local CANDLE = Color3.fromRGB(255, 200, 120)

-- ================================================================================ barn/10-core.luau
do
-- ================================================================ barn: the island, the ground, the mine, arrival
local core = folder("Core")

-- the ground of a cell: podzol/dirt paths, a trampled dirt barnyard (the arena), old planks inside the barn (the
-- barn part lays its floor), overgrown autumn weeds with podzol and coarse dirt patches everywhere else
local function groundTop(x, z)
	local n = n2(x, z, 3.3, 0.05)
	if inPitArea(x, z) then
		return "px_cobblestone", Color3.fromRGB(130, 126, 120), 0
	end
	if inBarn(x, z) then
		return "px_dirt", PODZOL, 0
	end
	if onPath(x, z) then
		return "px_dirt", if n > 0.25 then PODZOL else PATH_DIRT, 0
	end
	if inArena(x, z, 4) then
		return if n > 0.2 then "px_forest_floor" else "px_dirt", if n > 0.2 then nil else PODZOL, 0
	end
	if n > 0.32 then
		return "px_forest_floor", nil, 0
	end
	if n < -0.36 then
		return "px_dirt", PODZOL, 0
	end
	return "px_grass_top", WEEDS, 0
end
-- the island hangs as a terraced block of dirt and stone (16-stud steps), ragged near the rim
local function rockDepth(x, z)
	local rr = math.clamp(math.sqrt(x * x + z * z) / ISLAND_R, 0, 1)
	local d = 16 + (1 - rr) ^ 1.2 * 130
	if rr > 0.85 then
		d += (n2(x, z, 7.7, 0.09) + 0.5) * 24
	end
	return math.max(12, math.floor(d / 16 + 0.5) * 16)
end
local _, islandRuns = island({
	x0 = -240,
	x1 = 240,
	z0 = -240,
	z1 = 240,
	cell = 8,
	shape = function(x, z)
		return onIsland(x, z)
	end,
	top = groundTop,
	depth = rockDepth,
	rockTop = "px_dirt",
	rockTopTint = Color3.fromRGB(130, 100, 76),
	rockLow = "px_stone",
	rockLowTint = Color3.fromRGB(120, 120, 126),
}, core)
task.wait()

-- ================================================================ the mine in front of the barn
local mine = minePit({
	x = PIT.x,
	z = PIT.z,
	size = PIT.size,
	depth = PIT.depth,
	wall = "px_stone_bricks",
	wallTint = Color3.fromRGB(110, 100, 96),
	rim = "px_cobblestone",
	rimTint = Color3.fromRGB(130, 126, 120),
}, core)
local arrive = folder("Arrival", core)
arrival(SPAWN.x, SPAWN.z, PIT.x, PIT.z, arrive, "px_planks")
do
	local cf = at(BUYER.x, 0, BUYER.z) * CFrame.Angles(0, math.pi / 2, 0)
	stall(cf, {
		w = 4 * B,
		d = 2 * B,
		colA = Color3.fromRGB(170, 40, 36),
		colB = Color3.fromRGB(226, 218, 200),
		goods = { "px_hay", "px_hay", "px_hay" },
		sign = "Скупка",
	}, arrive)
	buyer(cf * CFrame.new(0, 3, 1.4), { shirt = Color3.fromRGB(110, 70, 40), pants = Color3.fromRGB(60, 54, 50) }, arrive)
	crate(BUYER.x + 4, 0, BUYER.z + 10, arrive)
	barrel(BUYER.x - 2, 0, BUYER.z + 10, arrive)
	lampPost(BUYER.x - 10, BUYER.z - 8, arrive)
	zoneSign(SPAWN.x - 14, SPAWN.z + 8, "Амбар", math.pi, arrive)
end

-- ================================================================ the boss, the dusk, the void net, the edge walls
bossSpawn("forest_guardian", ARENA.x, 2, ARENA.z, ARENA.r - 8, core)
-- an autumn dusk with fog over the whole island (the only lighting volume of this floor); pumpkins give the light
lightingVolume("AutumnDusk", 0, 80, 0, 520, 360, 520, {
	Ambient = Color3.fromRGB(170, 132, 104),
	Exposure = -0.05,
	Haze = 0.38,
	ClockTime = 17.6,
	Brightness = 1.4,
	AtmosphereColor = Color3.fromRGB(214, 156, 108),
	AtmosphereDecay = Color3.fromRGB(110, 72, 60),
}, core)
do
	local net = part("VoidCatch", Vector3.new(800, 10, 800), at(0, -240, 0), nil, nil, core)
	net.Transparency = 1
	net.CanCollide = false
	net.CanTouch = false
	net.CastShadow = false
	net:SetAttribute("LocationId", LOC)
	CollectionService:AddTag(net, "VoidCatch")
	local E = ISLAND_R + 28
	edgeWalls({ { 0, -E, 2 * E, 4 }, { 0, E, 2 * E, 4 }, { -E, 0, 4, 2 * E }, { E, 0, 4, 2 * E } }, core)
end
print(("[build-barn] core: island runs %d"):format(islandRuns))

end
task.wait()
local total = #root:GetDescendants()
print(("[build-barn] built: %d instances, %d parts"):format(total, count))
return ("built %d instances, %d parts"):format(total, count)
