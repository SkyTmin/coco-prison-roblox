	-- the stepped crown of white wool (3, 5, 4, 3, 1 blocks wide) and a few loose puffs
	for i, l in ipairs({ { -6, -2, 3 }, { -2, 2, 5 }, { 2, 6, 4 }, { 6, 10, 3 }, { 10, 13, 1 } }) do
		local r = l[3] * B / 2
		box(
