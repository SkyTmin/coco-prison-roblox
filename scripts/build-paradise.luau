	textured(part("LampPost", Vector3.new(1, 9, 1), cf * CFrame.new(0, 5.5, 0), nil, nil, parent), WOOD_DARK)
	textured(part("LampArm", Vector3.new(1, 1, 3.5), cf * CFrame.new(0, 9.5, -1.5), nil, nil, parent), WOOD_DARK)
