-- a lighting volume read by src/client/IndoorLighting.luau (Ambient, Exposure, Haze, ClockTime, Brightness,
-- AtmosphereColor, AtmosphereDecay)
local function lightingVolume(name, cx, cy, cz, sx, sy, sz, attrs, parent)
	local model = Instance.new("Model")
	model.Name = "IndoorLighting"
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	model.Parent = parent or root
	local v = decor(part(name, Vector3.new(sx, sy, sz), at(cx, cy, cz), nil, nil, model))
	v.Transparency = 1
	for k, val in pairs(attrs) do
		v:SetAttribute(k, val)
	end
	CollectionService:AddTag(v, "IndoorLighting")
	return v
end

-- ================================================================ the floating island (8-stud cells)
-- opt.shape(x, z) -> true on land; opt.top(x, z) -> variant, tint, y (the top surface height, local); opt.depth(x, z)
-- -> studs of rock below the ground block. The column is: ground (1 block, the top variant), rock (24 studs,
-- opt.rockTop) and below that opt.rockLow down to the depth. opt.voids = { {x0, x1, z0, z1, y0, y1} or
-- {cx, cz, r, y0, y1, circle = true} }: carved out of the column (crypts, tunnels, holes) — the parts that live
-- there are built by the location itself. opt.pit = PIT ({x, z, size, depth}): the mine hole is carved out too (half a
-- cell wider, under the pit walls) so the mine blocks are not buried in rock. Equal neighbouring cells along x are
-- merged into one run.
local function island(opt, parent)
	local f = folder("Island", parent)
	local C = opt.cell or 8
	local x0, x1, z0, z1 = opt.x0, opt.x1, opt.z0, opt.z1
	local voids = table.clone(opt.voids or {})
	if opt.pit then
		local p = opt.pit
		local e = p.size * B / 2 + C / 2
		table.insert(voids, { p.x - e, p.x + e, p.z - e, p.z + e, -p.depth * B, 2 * B })
	end
	local runs = 0
	-- the column segments of one cell: { {ya, yb, layer}, ... } with layer 1 ground, 2 rock, 3 low rock
	local function column(cx, cz)
		local var, tint, y = opt.top(cx, cz)
		local d = math.floor(opt.depth(cx, cz) / B + 0.5) * B
		local segs = { { y - B, y, 1 } }
		if d > 0 then
			table.insert(segs, { y - B - math.min(d, 24), y - B, 2 })
			if d > 24 then
				table.insert(segs, { y - B - d, y - B - 24, 3 })
			end
		end
		for _, v in ipairs(voids) do
			local inside, vy0, vy1
			if v.circle then
				inside = (cx - v[1]) ^ 2 + (cz - v[2]) ^ 2 <= v[3] * v[3]
				vy0, vy1 = v[4], v[5]
			else
				inside = cx >= v[1] and cx <= v[2] and cz >= v[3] and cz <= v[4]
				vy0, vy1 = v[5], v[6]
			end
			if inside then
				local cut = {}
				for _, s in ipairs(segs) do
					if s[2] <= vy0 or s[1] >= vy1 then
						table.insert(cut, s)
					else
						if s[1] < vy0 then
							table.insert(cut, { s[1], vy0, s[3] })
						end
						if s[2] > vy1 then
							table.insert(cut, { vy1, s[2], s[3] })
						end
					end
				end
				segs = cut
			end
		end
		local key = tostring(var) .. "|" .. tostring(tint)
		for _, s in ipairs(segs) do
			key ..= "|" .. s[1] .. ":" .. s[2] .. ":" .. s[3]
		end
		return key, segs, var, tint
	end
	for z = z0, z1 - C, C do
		local runStart, runKey, runSegs, runVar, runTint = nil, nil, nil, nil, nil
		local function flush(xEnd)
			if runStart then
				for _, s in ipairs(runSegs) do
					local name, variant, tint = "Ground", runVar, runTint
					if s[3] == 2 then
						name, variant, tint = "Rock", opt.rockTop or "px_stone", opt.rockTopTint
					elseif s[3] == 3 then
						name, variant, tint = "RockLow", opt.rockLow or "px_cobblestone", opt.rockLowTint
					end
					if s[2] - s[1] > 0.05 then
						box(name, runStart, s[1], z, xEnd, s[2], z + C, variant, tint, f)
					end
				end
				runs += 1
				if runs % 300 == 0 then
					task.wait()
				end
			end
			runStart = nil
		end
		for x = x0, x1 - C, C do
			local cx, cz = x + C / 2, z + C / 2
			if opt.shape(cx, cz) then
				local key, segs, var, tint = column(cx, cz)
				if key ~= runKey then
					flush(x)
					runStart, runKey, runSegs, runVar, runTint = x, key, segs, var, tint
				end
			else
				flush(x)
				runKey = nil
			end
		end
		flush(x1)
	end
	return f, runs
end

-- ================================================================ the location parts follow (scripts/locations/<id>/*.luau)

-- ================================================================================ paradise/05-plan.luau
-- ================================================================ paradise: the plan shared by every part
local ISLAND = { x = 0, z = 0, r = 236 }
local ROSE = { x = 0, z = -84, river = 120, bank = 108, crown = 28, step = 4 }
local TIERS = { 108, 92, 76, 60, 44, 28 } -- tier k (1..6) lies inside TIERS[k] at y 4k; the crown (k 6) is the SUMMIT
local RIVER_BED, RIVER_TOP, GLASS_TOP = -4, -0.8, 0 -- one block deep, covered by yellow glass at y 0 (walkable)
local RAYS = 12 -- rays of steps from the river to the crown, ray 0 points south (to the pit)
local PIT = { x = 0, z = 124, size = 32, depth = 12 }
local PIT_HALF = PIT.size * B / 2 -- 64
local SPAWN = { x = 0, z = 214 }
local BUYER = { x = -36, z = 216 }
local SUMMIT = { x = 0, z = -84, y = 24 }
local ISLES = {
	{ name = "west", x = -296, z = 0, r = 40 },
	{ name = "east", x = 296, z = 0, r = 40 },
	{ name = "northWest", x = -226, z = -176, r = 32 },
	{ name = "northEast", x = 226, z = -176, r = 32 },
	{ name = "southWest", x = -226, z = 176, r = 32 },
	{ name = "southEast", x = 226, z = 176, r = 32 },
}
local BRIDGES =
	{ -- { x0, z0, x1, z1 } decks at y 0 (the sky part measures the real gap from the cells)
		{ -264, -8, -228, 8 },
		{ 228, -8, 264, 8 },
		{ -200, -184, -150, -168 },
		{ 150, -184, 200, -168 },
		{ -200, 168, -150, 184 },
		{ 150, 168, 200, 184 },
	}
local WALKS = { -- { x0, z0, x1, z1 } main walkways at y 0 kept clear of props
	{ -10, 196, 10, 236 }, -- the south axis from the pit to the arrival and the south edge
	{ -10, 36, 10, 52 }, -- from the pit's north side to the river and the south ray
	{ -236, -8, -84, 8 }, -- west to the bridge W
	{ 84, -8, 236, 8 },
	{ -160, -184, -76, -168 }, -- north-west to the bridge NW (from the river)
	{ 76, -184, 160, -168 },
	{ -160, 168, -72, 184 }, -- south-west to the bridge SW (from the pit area)
	{ 72, 168, 160, 184 },
}

local function inRect(x, z, r, pad)
	pad = pad or 0
	return x >= r[1] - pad and x <= r[3] + pad and z >= r[2] - pad and z <= r[4] + pad
end
local function inPitArea(x, z, pad)
	local e = PIT_HALF + 2 * B + (pad or 0)
	return math.abs(x - PIT.x) <= e and math.abs(z - PIT.z) <= e
end
local function roseDist(x, z)
	return math.sqrt((x - ROSE.x) ^ 2 + (z - ROSE.z) ^ 2)
end
-- the ray a point is nearest to (0..RAYS-1) and its sideways distance from that ray's centre line
local function rayOf(x, z)
	local a = math.atan2(x - ROSE.x, z - ROSE.z) -- 0 = south, +π/2 = east
	local step = 2 * math.pi / RAYS
	local k = math.floor(a / step + 0.5)
	local off = (a - k * step) * roseDist(x, z)
	return k % RAYS, math.abs(off)
end
-- which island a point is on: "main", an islet's name or nil (the sky); noise reads |x| (mirror-symmetric)
local function isleOf(x, z, pad)
	local r = ISLAND.r + n2(math.abs(x), z, 4.4, 0.04) * 9 - (pad or 0)
	if (x - ISLAND.x) ^ 2 + (z - ISLAND.z) ^ 2 <= r * r then
		return "main"
	end
	for _, s in ipairs(ISLES) do
		local rr = s.r + n2(math.abs(x), z, 5.1, 0.05) * 6 - (pad or 0)
		if (x - s.x) ^ 2 + (z - s.z) ^ 2 <= rr * rr then
			return s.name
		end
	end
	return nil
end
local function onRiver(x, z, pad)
	pad = pad or 0
	local d = roseDist(x, z)
	return d >= ROSE.bank - pad and d <= ROSE.river + pad
end
-- the tier of a point: 0 outside the rose (and on the river), 1..6 inside
local function tierOf(x, z)
	local d = roseDist(x, z)
	local k = 0
	for i, r in ipairs(TIERS) do
		if d < r then
			k = i
		end
	end
	return k
end
-- the ground height: the tiers y 4k, the river bed y -4 (under the glass at y 0), the plaza y 0
local function groundY(x, z)
	if not isleOf(x, z) then
		return nil
	end
	if onRiver(x, z) then
		return RIVER_BED
	end
	return tierOf(x, z) * ROSE.step
end
local function onPath(x, z, pad)
	for _, w in ipairs(WALKS) do
		if inRect(x, z, w, pad) then
			return true
		end
	end
	return false
end
-- the part that owns a point: "rose", "plaza" or "sky"
local function zoneOf(x, z)
	if isleOf(x, z) ~= "main" then
		return "sky"
	end
	return if roseDist(x, z) < ROSE.river + 4 then "rose" else "plaza"
end
-- free ground for props: on an island, off the walks, the river, the pit, the arrival and the buyer
local function freeGround(x, z, pad)
	pad = pad or 0
	return isleOf(x, z, 10 + pad) ~= nil
		and not onPath(x, z, 2 + pad)
		and not onRiver(x, z, 4 + pad)
		and not inPitArea(x, z, 4 + pad)
		and math.sqrt((x - SPAWN.x) ^ 2 + (z - SPAWN.z) ^ 2) > 20 + pad
		and math.sqrt((x - BUYER.x) ^ 2 + (z - BUYER.z) ^ 2) > 14 + pad
end

-- palette: almost monochrome white, gold accents, the scarlet heart (tints over coloured textures stay light)
local WHITE = Color3.fromRGB(250, 250, 248) -- over px_smooth_stone (white concrete)
local QUARTZ = Color3.fromRGB(246, 243, 236) -- over px_white_stone_bricks / px_smooth_stone
local CALCITE = Color3.fromRGB(232, 234, 230)
local SNOW = Color3.fromRGB(244, 248, 255)
local GOLD = Color3.fromRGB(255, 236, 170) -- a tint over px_gold_block (keep it light)
local GOLD_GLASS = Color3.fromRGB(255, 214, 90) -- the yellow glass over the golden river
local GOLD_WATER = Color3.fromRGB(240, 196, 70)
local SCARLET = Color3.fromRGB(205, 40, 40) -- red flowers, the heart
local PETAL = Color3.fromRGB(250, 190, 210)
local LEAF = Color3.fromRGB(170, 205, 150) -- a tint over px_hedge (vines, bushes)
local BIRCH = Color3.fromRGB(250, 250, 246) -- a light tint over px_birch_log
local WATER = Color3.fromRGB(110, 170, 240)
local LIGHT = Color3.fromRGB(255, 244, 214)
local CLOUD = Color3.fromRGB(252, 252, 255)

-- ================================================================================ paradise/10-core.luau
do
-- ================================================================ paradise: the islands, the tiers, the river, the mine, arrival
local core = folder("Core")

-- the ground of a cell: the tiers alternate white concrete and quartz, the crown calcite, the river bed gold, the plaza
-- a white checker of concrete and quartz bricks, a quartz band along the rim; the islets white
local function groundTop(x, z)
	local isle = isleOf(x, z)
	local cx, cz = math.floor(x / 8), math.floor(z / 8)
	local even = (cx + cz) % 2 == 0
	if isle ~= "main" then
		return "px_smooth_stone", if even then WHITE else SNOW, 0
	end
	if onRiver(x, z) then
		return "px_gold_block", GOLD, RIVER_BED
	end
	local k = tierOf(x, z)
	if k == 6 then
		return "px_smooth_stone", CALCITE, k * ROSE.step
	end
	if k > 0 then
		return if k % 2 == 1 then "px_smooth_stone" else "px_white_stone_bricks",
			if k % 2 == 1 then WHITE else QUARTZ,
			k * ROSE.step
	end
	if inPitArea(x, z) then
		return "px_white_stone_bricks", QUARTZ, 0
	end
	if isleOf(x, z, 8) == nil then
		return "px_white_stone_bricks", QUARTZ, 0 -- the rim band
	end
	return if even then "px_smooth_stone" else "px_white_stone_bricks",
		if even then WHITE else QUARTZ,
		0
end
-- the islands hang as white stone over snow-white stone (16-stud steps), ragged at the rim; a tier's column reaches
-- the same bottom as the plaza round it
local function rockDepth(x, z)
	local isle = isleOf(x, z)
	local rr, deep
	if isle == "main" then
		rr = math.sqrt((x - ISLAND.x) ^ 2 + (z - ISLAND.z) ^ 2) / ISLAND.r
		deep = 160
	else
		for _, s in ipairs(ISLES) do
			if s.name == isle then
				rr = math.sqrt((x - s.x) ^ 2 + (z - s.z) ^ 2) / s.r
			end
		end
		deep = 60
	end
	rr = math.clamp(rr, 0, 1)
	local d = 16 + (1 - rr) ^ 1.15 * deep
	if rr > 0.82 then
		d += (n2(math.abs(x), z, 7.7, 0.09) + 0.5) * 28
	end
	d = math.max(8, math.floor(d / 16 + 0.5) * 16)
	return d + (groundY(x, z) or 0)
end
local _, islandRuns = island({
	pit = PIT, -- the mine hole stays open
	x0 = -352,
	x1 = 352,
	z0 = -248,
	z1 = 248,
	cell = 8,
	shape = function(x, z)
		return isleOf(x, z) ~= nil
	end,
	top = groundTop,
	depth = rockDepth,
	rockTop = "px_white_stone_bricks",
	rockTopTint = QUARTZ,
	rockLow = "px_smooth_stone",
	rockLowTint = SNOW,
}, core)
task.wait()

-- ================================================================ the golden river under yellow glass (walked on)
do
	local riverF = folder("GoldenRiver", core)
	local runs = 0
	for z = -248, 240, 8 do
		local runStart = nil
		local function flush(xEnd)
			if runStart then
				local w = part(
					"RiverWater",
					Vector3.new(xEnd - runStart, RIVER_TOP - RIVER_BED, 8),
					at((runStart + xEnd) / 2, (RIVER_BED + RIVER_TOP) / 2, z + 4),
					GOLD_WATER,
					Enum.Material.Glass,
					riverF
				)
				w.Transparency = 0.25
				w.CanCollide = false
				w.CastShadow = false
				local g = part(
					"RiverGlass",
					Vector3.new(xEnd - runStart, 0.4, 8),
					at((runStart + xEnd) / 2, GLASS_TOP - 0.2, z + 4),
					GOLD_GLASS,
					Enum.Material.Glass,
					riverF
				)
				g.Transparency = 0.45
				g.CastShadow = false
				runs += 1
			end
			runStart = nil
		end
		for x = -352, 344, 8 do
			local cx, cz = x + 4, z + 4
			if isleOf(cx, cz) == "main" and onRiver(cx, cz) then
				runStart = runStart or x
			else
