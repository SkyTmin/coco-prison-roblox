-- a white planter (2×1 blocks) with red flower bushes
local function flowerPlanter(x, z, alongX, parent)
	local ex, ez = if alongX then 4 else 2, if alongX then 2 else 4
	if not claim("Planter", x - ex, z - ez, x + ex, z + ez) then
