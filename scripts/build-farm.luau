-- ================================================================ basic parts
local function part(name, size, cf, color, material, parent)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Anchored = true
	p.Color = color or Color3.fromRGB(200, 200, 200)
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent or root
	count += 1
	if count % 1500 == 0 then
		task.wait()
	end
	return p
end
local function wedge(name, size, cf, color, material, parent)
	local p = Instance.new("WedgePart")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Anchored = true
	p.Color = color or Color3.fromRGB(200, 200, 200)
	p.Material = material or Enum.Material.SmoothPlastic
	p.Parent = parent or root
	count += 1
	return p
end
-- our pixel texture on a part; tint multiplies the texture (white = as drawn)
local function textured(p, variant, tint)
	p.Material = Enum.Material.Plastic
	p.MaterialVariant = variant
	p.Color = tint or Color3.new(1, 1, 1)
	return p
end
local function decor(p)
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	return p
end
local function at(x, y, z)
	return CFrame.new(BX + x, BY + y, BZ + z)
end
local function V(x, y, z)
	return Vector3.new(BX + x, BY + y, BZ + z)
end
local function folder(name, parent)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent or root
	return f
end
-- a textured box by its two corners (local studs) — the main building brick of the kit
local function box(name, x0, y0, z0, x1, y1, z1, variant, tint, parent)
	local sx, sy, sz = math.abs(x1 - x0), math.abs(y1 - y0), math.abs(z1 - z0)
	local p = part(name, Vector3.new(sx, sy, sz), at((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2), tint, nil, parent)
	if variant then
		textured(p, variant, tint)
	end
	return p
end
-- a textured box by centre and size (local)
local function cube(name, x, y, z, sx, sy, sz, variant, tint, parent)
	local p = part(name, Vector3.new(sx, sy, sz), at(x, y, z), tint, nil, parent)
	if variant then
		textured(p, variant, tint)
	end
	return p
end
local function beam(name, a, b, thick, color, parent, material)
	local len = (b - a).Magnitude
	return part(name, Vector3.new(thick, thick, len), CFrame.lookAt((a + b) / 2, b), color, material, parent)
end
local LIGHT_POWER, LIGHT_RANGE = 0.45, 0.7
local function light(p, range, brightness, color)
	local l = Instance.new("PointLight")
	l.Range = range * LIGHT_RANGE
	l.Brightness = brightness * LIGHT_POWER
	l.Color = color
	l.Shadows = false
	l.Parent = p
	return l
end
local function emitter(p, props)
	local e = Instance.new("ParticleEmitter")
	for k, v in pairs(props) do
		e[k] = v
	end
	e.Parent = p
	return e
end
local function n2(x, z, seed, scale)
	return math.noise(x * scale, z * scale, seed)
end
local function segDist(px, pz, ax, az, bx, bz)
	local dx, dz = bx - ax, bz - az
	local t = math.clamp(((px - ax) * dx + (pz - az) * dz) / (dx * dx + dz * dz), 0, 1)
	return math.sqrt((px - ax - dx * t) ^ 2 + (pz - az - dz * t) ^ 2), t
end
local function pick(list)
	return list[rng:NextInteger(1, #list)]
end
local function snap(v)
	return math.floor(v / B + 0.5) * B
end

-- ================================================================ text
local function sign(target, text, offset, color, maxDistance)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(150, 24)
	gui.StudsOffset = Vector3.new(0, offset or 4, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = maxDistance or 140
	gui.Parent = target
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextColor3 = color or Color3.fromRGB(255, 190, 60)
	label.TextStrokeTransparency = 0.2
	label.TextScaled = true
	label.Font = Enum.Font.Code
	label.Text = text
	label.Parent = gui
end
local function boardText(target, text, color, faces)
	for _, face in ipairs(faces or { Enum.NormalId.Front, Enum.NormalId.Back }) do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		gui.MaxDistance = 90
		gui.LightInfluence = 0.5
		gui.Parent = target
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(0.92, 0.8)
		label.Position = UDim2.fromScale(0.04, 0.1)
		label.BackgroundTransparency = 1
		label.TextColor3 = color or Color3.fromRGB(245, 235, 215)
		label.TextStrokeTransparency = 0.4
		label.TextScaled = true
		label.Font = Enum.Font.Code
		label.Text = text
		label.Parent = gui
	end
end
-- a wooden signpost with a board, the board text on both faces (zones, directions)
local function zoneSign(x, z, text, yaw, parent)
