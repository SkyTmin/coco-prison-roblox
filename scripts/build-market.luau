		if free(x, z, 3) then
			rb("SkullPost", at(x, FLOOR + 3, z), 1, 6, 1, "px_dark_oak_log", nil, f)
			skull(CFrame.lookAt(V(x, FLOOR + 7, z), V(CX, FLOOR + 7, CZ)), 1, f)
