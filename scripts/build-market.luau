local function buyer(cf, opt, parent)
	opt = opt or {}
	opt.tag = "SellPoint"
	opt.label = "Скупщик блоков"
	opt.labelColor = Color3.fromRGB(255, 55, 55)
	return npc("Buyer", cf, opt, parent)
end
