	bp("SkelLeg", 0.9, 2, 0, 1, 4, 1)
	bp("SkelPelvis", 0, 4.5, 0, 3, 1, 1.6)
	bp("SkelSpine", 0, 5.6, 0, 1, 1.2, 1)
	bp("SkelRibs", 0, 7.6, 0, 3.4, 2.8, 2)
	bp("SkelArm", -2.2, 7.2, 0, 1, 4, 1)
	bp("SkelArm", 2.2, 7.2, 0, 1, 4, 1)
