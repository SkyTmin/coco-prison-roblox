end
local function crate(x, y, z, parent, s, yaw)
	s = s or B
	local p = part("Crate", Vector3.new(s, s, s), at(x, y + s / 2, z) * CFrame.Angles(0, yaw or 0, 0), nil, nil, parent)
	textured(p, WOOD_LIGHT, Color3.fromRGB(215, 175, 120))
	decor(part("CrateBand", Vector3.new(s + 0.1, 0.4, s + 0.1), p.CFrame, Color3.fromRGB(110, 80, 50), Enum.Material.Wood, parent))
