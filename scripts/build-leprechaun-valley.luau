	z0 = -ISLAND_R - 24,
	z1 = ISLAND_R + 24,
	cell = 8,
	shape = onIsland,
	top = groundTop,
	depth = rockDepth,
	rockTop = "px_dirt",
	rockTopTint = Color3.fromRGB(150, 120, 95),
	rockLow = "px_stone",
	rockLowTint = STONE_T,
}, core)
