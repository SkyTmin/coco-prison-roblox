local function barrel(x, y, z, parent, topVariant)
	local p = cube("Barrel", x, y + 2, z, B, B, B, "px_spruce_planks", Color3.fromRGB(150, 110, 80), parent)
	for _, h in ipairs({ 0.6, 3.4 }) do
		decor(part("Hoop", Vector3.new(B + 0.1, 0.3, B + 0.1), at(x, y + h, z), Color3.fromRGB(70, 70, 75), Enum.Material.Metal, parent))
	end
	if topVariant then
		textured(decor(part("BarrelGoods", Vector3.new(B - 0.6, 0.5, B - 0.6), at(x, y + B + 0.25, z), nil, nil, parent)), topVariant)
