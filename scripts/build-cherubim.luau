					"EyeSlit",
					p + face * 4.2,
					nrm,
					rad,
					Vector3.new(1.6, 0.4, 5),
					"px_smooth_stone",
					Color3.fromRGB(214, 214, 220),
					f
				)
				obox(
					"EyePupil",
					p + face * 4.35,
					nrm,
					rad,
					Vector3.new(1.2, 0.4, 1.4),
					"px_iron_block",
					IRON,
					f
				)
			elseif p.Y >= 44 and p.Y <= 150 then
				table.insert(cands, { p = p, rad = rad })
			end
			if k % 40 == 39 then
				task.wait()
			end
		end
		-- 10 lanterns on chains from the band's lowest edge, 2 of them lit
		local hung = 0
