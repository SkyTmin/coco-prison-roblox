				if patch then "px_smooth_stone" else "px_gold_block",
				if patch then HONEY else GOLD,
				f
			)
			-- the spine on the outer face
			obox(
				"RingSpine",
				p + rad * 2.6,
				nrm,
				rad,
				Vector3.new(4, 1.4, L),
				"px_gold_block",
				GOLD_DEEP,
				f
			)
